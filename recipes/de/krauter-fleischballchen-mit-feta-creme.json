  "steps": [
    {
      "text": "Kartoffeln waschen und in Spalten schneiden."
    },
    {
      "text": "Die Kartoffelspalten mit dem Abrieb einer Zitrone, etwas Öl, Paprikapulver, Knoblauchpulver, Salz und Pfeffer marinieren und für 25 Minuten bei 160 °C in den Airfryer geben.",
      "timerMinutes": 25
    },
    {
      "text": "Pinienkerne ohne Öl in einer Pfanne anrösten.",
      "timerMinutes": 3
    },
    {
      "text": "Das Hackfleisch mit einem Teil der Pinienkerne, Eigelb, Minze, Dill, Petersilie, Chilipulver, Paniermehl, Salz und Pfeffer vermengen und kleine Fleischbällchen rollen."
    },
    {
      "text": "Die Fleischbällchen für 12 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 12
    },
    {
      "text": "Für die Creme den Feta mit griechischem Joghurt, Olivenöl, dem Saft einer Zitrone, Pfeffer und Salz pürieren."
    },
    {
      "text": "Zum Anrichten die Fleischbällchen mit den Kartoffelspalten auf der Creme anrichten und die restlichen Pinienkerne darüber streuen."
    }
  ]

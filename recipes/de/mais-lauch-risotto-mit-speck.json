  "steps": [
    {
      "text": "Knollensellerie, Schalotte und Knoblauch schälen und kleinschneiden. Den Lauch in Ringe schneiden.",
      "ingredients": [
        {
          "ingredient": 0
        },
        {
          "ingredient": 2
        },
        {
          "ingredient": 9
        },
        {
          "ingredient": 1
        }
      ]
    },
    {
      "text": "Die Butter in einer Pfanne zerlaufen lassen und die kleingeschnittenen Zutaten anbraten.",
      "timerMinutes": 5,
      "ingredients": [
        {
          "ingredient": 10
        }
      ]
    },
    {
      "text": "Den Reis dazugeben, kurz anbraten und dann mit Gemüsebrühe und Apfelsaft ablöschen.",
      "ingredients": [
        {
          "ingredient": 6
        },
        {
          "ingredient": 11
        },
        {
          "ingredient": 8
        }
      ]
    },
    {
      "text": "Immer nur so viel Brühe nachgießen, dass der Reis bedeckt ist, und den Reis garen.",
      "timerMinutes": 20
    },
    {
      "text": "In einer anderen Pfanne den Bacon mit dem Thymian knusprig anbraten.",
      "timerMinutes": 5,
      "ingredients": [
        {
          "ingredient": 5
        },
        {
          "ingredient": 3
        }
      ]
    },
    {
      "text": "Gegen Ende den Mais abgießen, mit in die Pfanne geben und den Parmesan hineinreiben.",
      "ingredients": [
        {
          "ingredient": 7
        },
        {
          "ingredient": 4
        }
      ]
    },
    {
      "text": "Das Risotto auf die Teller verteilen und mit dem Bacon servieren."
    }
  ]

  "steps": [
    {
      "text": "Kartoffeln waschen und in einem Topf kochen.",
      "timerMinutes": 25
    },
    {
      "text": "Pilze und Zwiebeln schneiden und in einer Pfanne mit etwas Öl anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Das Hähnchenschnitzel von beiden Seiten mit Pfeffer und Salz bestreuen."
    },
    {
      "text": "Drei tiefe Teller vorbereiten: In einem das Ei verquirlen, im anderen Mehl und im dritten Paniermehl verteilen."
    },
    {
      "text": "Das Schnitzel in dieser Reihenfolge in zwei Durchgängen panieren."
    },
    {
      "text": "Die Kochsahne in die Pfanne geben und mit Pfeffer und Salz würzen."
    },
    {
      "text": "Das Schnitzel für 2x 8 Minuten bei 200 °C in den Airfryer geben, dazwischen wenden.",
      "timerMinutes": 16
    },
    {
      "text": "Die Kartoffeln abgießen und auf den Teller geben. Die Champignons darüber verteilen und mit Petersilie garnieren. Den Saft der halben Zitrone nach Belieben über dem Schnitzel verteilen."
    }
  ]

  "steps": [
    {
      "text": "Die Schalotte kleinschneiden, den Parmesan reiben und den Lachs waschen und trocken tupfen."
    },
    {
      "text": "Die Nudeln mit etwas Salz in einem Topf kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Die Butter in einer Pfanne schmelzen und die Schalotte darin anbraten.",
      "timerMinutes": 2
    },
    {
      "text": "Den Lachs nach Belieben würzen, mit Zitronensaft beträufeln und für 16 Minuten bei 160 °C in den Airfryer geben.",
      "timerMinutes": 16
    },
    {
      "text": "Erbsen, Gemüsebrühe und Crème fraîche in die Pfanne geben und aufkochen lassen.",
      "timerMinutes": 3
    },
    {
      "text": "Die Nudeln abgießen und in die Pfanne geben."
    },
    {
      "text": "Alles auf die Teller aufteilen, den Lachs dazulegen und Parmesan darüberstreuen."
    }
  ]

  "steps": [
    {
      "text": "Pak Choi, Karotten, Lauchzwiebeln und Knoblauch klein schneiden. Den Tofu ausdrücken und ebenfalls klein schneiden."
    },
    {
      "text": "Die Mie-Nudeln in einer Schüssel mit heißem Wasser übergießen, 5 Minuten ziehen lassen und dann das Wasser abgießen.",
      "timerMinutes": 5
    },
    {
      "text": "Öl in einer Pfanne erhitzen und die Karotten anbraten. Danach den Tofu mit anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Wenn der Tofu leicht angebraten ist, Pak Choi, Knoblauch und Lauchzwiebeln mit in die Pfanne geben.",
      "timerMinutes": 3
    },
    {
      "text": "Für die Soße Erdnussbutter, Misopaste, Honig, Zitronensaft, Chilipulver, Sojasoße, Sesamöl und Wasser miteinander verrühren."
    },
    {
      "text": "Die Nudeln in die Pfanne geben und mit der Soße unterheben."
    }
  ]

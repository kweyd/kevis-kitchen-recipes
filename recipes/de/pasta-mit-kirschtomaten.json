  "steps": [
    {
      "text": "Die Nudeln kochen.",
      "timerMinutes": 9,
      "ingredients": [
        {
          "ingredient": 1
        }
      ]
    },
    {
      "text": "Schalotte und Knoblauch schälen und klein hacken.",
      "ingredients": [
        {
          "ingredient": 2
        },
        {
          "ingredient": 13
        }
      ]
    },
    {
      "text": "In einer Pfanne Olivenöl erhitzen und die Schalotte anbraten. Anschließend Knoblauch, Schinkenwürfel und Kirschtomaten dazugeben und braten, bis die Tomaten aufplatzen und ihren Saft verteilen.",
      "timerMinutes": 8,
      "ingredients": [
        {
          "ingredient": 14
        },
        {
          "ingredient": 3
        },
        {
          "ingredient": 0
        }
      ]
    },
    {
      "text": "Dann Tomatenmark, Apfelessig und Weißwein in die Pfanne geben und den Alkohol verkochen lassen.",
      "timerMinutes": 3,
      "ingredients": [
        {
          "ingredient": 11
        },
        {
          "ingredient": 10
        },
        {
          "ingredient": 6
        }
      ]
    },
    {
      "text": "Die Pinienkerne in einer anderen Pfanne anrösten.",
      "timerMinutes": 3,
      "ingredients": [
        {
          "ingredient": 4
        }
      ]
    },
    {
      "text": "Das Weißbrot in kleine Würfel schneiden, mit Olivenöl beträufeln und in der Pfanne, in der die Pinienkerne waren, goldbraun rösten.",
      "timerMinutes": 4,
      "ingredients": [
        {
          "ingredient": 5
        },
        {
          "ingredient": 14
        }
      ]
    },
    {
      "text": "Den Abrieb der Zitrone, Petersilie, Basilikum und den Großteil des Parmesans in die Soße geben. Mit Pfeffer und Salz abschmecken – wenn es zu sauer ist, mit etwas Zucker.",
      "ingredients": [
        {
          "ingredient": 12
        },
        {
          "ingredient": 8
        },
        {
          "ingredient": 9,
          "share": 0.75
        },
        {
          "ingredient": 7,
          "share": 0.8
        },
        {
          "ingredient": 15
        },
        {
          "ingredient": 16
        },
        {
          "ingredient": 17
        }
      ]
    },
    {
      "text": "Alles auf den Tellern anrichten und noch etwas Parmesan und Basilikum darübergeben.",
      "ingredients": [
        {
          "ingredient": 7,
          "share": 0.2
        },
        {

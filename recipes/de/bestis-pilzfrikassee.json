  "steps": [
    {
      "text": "Die Champignons putzen und in Scheiben schneiden. Die Kräuterseitlinge putzen und in mittelgroße Stücke zerreißen."
    },
    {
      "text": "Knoblauch schälen, zerdrücken und fein schneiden. Zwiebel und Möhren schälen und klein schneiden."
    },
    {
      "text": "Eine Pfanne erhitzen. Die Champignons ohne Öl braten, bis die austretende Flüssigkeit weitgehend verdampft ist. Anschließend beiseitestellen."
    },
    {
      "text": "Die Kräuterseitlinge ebenfalls kurz ohne Öl braten. Mit Paprikapulver und Kreuzkümmel würzen. Öl, Zwiebel und Knoblauch hinzufügen und glasig dünsten. Den Knoblauch nicht bräunen lassen."
    },
    {
      "text": "Die Butter in einem großen Topf schmelzen. Das Mehl einrühren und kurz anschwitzen, ohne es zu bräunen. Milch und Gemüsefond nach und nach unter kräftigem Rühren zugießen."
    },
    {
      "text": "Möhren, Erbsen und sämtliche Pilze samt Zwiebel und Knoblauch hinzufügen. Mit Muskatnuss, Salz, Zitronenabrieb und etwas Zitronensaft würzen. Nach Wunsch etwas Sahne unterrühren."
    },
    {
      "text": "Das Frikassee mindestens 30 Minuten bei kleiner Hitze köcheln lassen. Gelegentlich umrühren und bei Bedarf etwas Flüssigkeit ergänzen.",
      "timerMinutes": 30
    },
    {
      "text": "Währenddessen den Reis nach Packungsanweisung in einem separaten Topf mit Wasser und etwas Salz kochen.",
      "timerMinutes": 15
    },
    {
      "text": "Sobald das Gemüse gar und die Sauce sämig ist, gehackte Petersilie unter das Frikassee rühren. Mit Pfeffer, Salz und Zitronensaft abschmecken."
    },
    {
      "text": "Das Frikassee mit dem Reis auf zwei Portionen verteilen und mit fein geschnittenem Lauchzwiebelgrün bestreuen."
    }
  ]
}

  "steps": [
    {
      "text": "Das Hähnchenbrustfilet in kleine Streifen schneiden und mit einer Sprühflasche etwas Öl daraufgeben."
    },
    {
      "text": "Die Hähnchenstreifen für 2x 8 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 16
    },
    {
      "text": "Spinat und Kiwi waschen und die Kiwi in Scheiben schneiden."
    },
    {
      "text": "In einer Schüssel Crème fraîche mit Senf, Pfeffer und Salz verrühren."
    },
    {
      "text": "Die Tortillas in einer heißen Pfanne ohne Öl von beiden Seiten erhitzen.",
      "timerMinutes": 2
    },
    {
      "text": "Die Tortillas in der Mitte mit der Creme bestreichen, Hähnchen, Kiwi und Spinat daraufgeben und zusammenrollen."

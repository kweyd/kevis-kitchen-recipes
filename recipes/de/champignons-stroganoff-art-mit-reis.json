  "steps": [
    {
      "text": "Die Möhre schälen und raspeln."
    },
    {
      "text": "In einem Topf die Butter erhitzen und den Reis mit den Möhrenraspeln darin anrösten. 300 ml kochendes Wasser dazugeben und mit Deckel bei mittlerer Hitze köcheln lassen.",
      "timerMinutes": 15
    },
    {
      "text": "Zwiebel und Knoblauch schälen. Den Knoblauch klein hacken und die Zwiebel in Ringe schneiden. Die Champignons in dünne Streifen schneiden."
    },
    {
      "text": "In einer Pfanne Öl erhitzen und die Zwiebeln anbraten. Anschließend Knoblauch und Champignons dazugeben.",
      "timerMinutes": 6
    },
    {
      "text": "Paprikapulver, Sojasoße, Kochsahne und Gemüsebrühe in die Pfanne geben."
    },
    {
      "text": "Die Speisestärke mit etwas Wasser vermischen und in die Pfanne geben."
    },
    {
      "text": "Gegen Ende den Spinat und die Petersilie hinzufügen und mit Pfeffer und Salz würzen."
    },
    {
      "text": "Alles auf den Tellern anrichten."
    }
  ]

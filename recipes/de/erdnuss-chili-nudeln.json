  "steps": [
    {
      "text": "Den Tofu mit Küchenpapier ausdrücken und in kleine Würfel schneiden. Die Zwiebel schälen und kleinschneiden."
    },
    {
      "text": "Zwiebel und Tofu in einem Topf mit etwas Öl anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Knoblauch und Ingwer klein schneiden und in den Topf geben. Nach ein paar Minuten die Hot Pepper Paste hinzugeben.",
      "timerMinutes": 3
    },
    {
      "text": "Gemüsebrühe, Kokosnussmilch, Sojasoße, Crispy Chili Öl und Erdnussbutter mit in den Topf geben. Mit Salz und Chiliflocken abschmecken."
    },
    {
      "text": "Die Mie-Nudeln mit kochendem Wasser übergießen und 5 Minuten ziehen lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Die Sesamsamen in einer Pfanne ohne Öl rösten."
    },
    {
      "text": "Die Nudeln abgießen und mit der Soße auf die Teller verteilen. Mit Lauchzwiebeln und Sesam garnieren."
    }
  ]

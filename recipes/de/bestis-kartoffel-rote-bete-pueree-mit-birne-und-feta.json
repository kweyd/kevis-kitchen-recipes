  "steps": [
    {
      "text": "Die Kartoffeln in gleich große Stücke schneiden und in Salzwasser etwa 20 Minuten weich kochen.",
      "timerMinutes": 20
    },
    {
      "text": "Währenddessen die Walnüsse grob zerteilen. Den Zucker mit 1 TL Wasser in einer kleinen Pfanne erhitzen, bis er schmilzt und leicht goldbraun wird. Die Walnüsse unterrühren und anschließend auf Backpapier verteilen. Abkühlen lassen."
    },
    {
      "text": "Die Birne waschen, vierteln und entkernen. In sehr dünne Scheiben schneiden oder hobeln und mit Zitronensaft beträufeln. Wer mag, legt die Scheiben später überlappend zu einer Rose."
    },
    {
      "text": "Die Rote Bete klein schneiden, mit der Milch in einem kleinen Topf erwärmen und anschließend fein pürieren."
    },
    {
      "text": "Die Kartoffeln abgießen und kurz ausdampfen lassen. Mit der Butter zerstampfen oder durch eine Kartoffelpresse drücken."
    },
    {
      "text": "Das warme Rote-Bete-Püree unter die Kartoffeln rühren. Mit Salz, Pfeffer und etwas Muskatnuss abschmecken. Bei Bedarf einen kleinen Schuss Wasser hinzufügen."
    },
    {
      "text": "Das Püree auf zwei Tellern verstreichen. Die Birnenscheiben darauf anrichten."
    },
    {
      "text": "Den Feta darüberbröseln und mit den karamellisierten Walnüssen bestreuen."
    }
  ]
}

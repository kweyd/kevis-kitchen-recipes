  "steps": [
    {
      "text": "Hähnchen klein schneiden und mit Pfeffer, Salz, Knoblauch, Kardamom, Thymian und der Hälfte vom Paprikapulver würzen."
    },
    {
      "text": "Das Hähnchen für 8 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 8
    },
    {
      "text": "Das Gemüse bei 150 °C für 14 Minuten in den Airfryer geben.",
      "timerMinutes": 14
    },
    {
      "text": "Den Frischkäse mit Pfeffer, Salz, dem restlichen Paprikapulver, Curry und Misopaste würzen. Etwas Wasser dazugeben und cremig rühren."
    },
    {
      "text": "Das Hähnchen wenden, die Frischkäsesoße darübergeben und für weitere 8 Minuten bei 200 °C in den Airfryer geben.",

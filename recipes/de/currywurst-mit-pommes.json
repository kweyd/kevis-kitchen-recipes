  "steps": [
    {
      "text": "Die Pommes im Airfryer zubereiten: leicht mit Öl besprühen und 2 × 10 Minuten bei 200 °C garen.",
      "timerMinutes": 20
    },
    {
      "text": "Die Zwiebel klein schneiden und in einer Pfanne mit Öl anbraten, bis sie leicht bräunlich wird.",
      "timerMinutes": 4
    },
    {
      "text": "Dann den Honig dazugeben und die Zwiebeln karamellisieren. Alles mit den passierten Tomaten ablöschen.",
      "timerMinutes": 2
    },
    {
      "text": "Die restlichen Zutaten für die Soße dazugeben und bei mittlerer Hitze köcheln lassen.",
      "timerMinutes": 10
    },
    {
      "text": "Parallel dazu in einer anderen Pfanne die Würstchen braten.",
      "timerMinutes": 10
    },
    {
      "text": "Die Würstchen schneiden, auf die Teller verteilen und die Currywurstsoße darübergeben."
    },
    {
      "text": "Die Pommes auf beide Teller aufteilen und etwas Schnittlauch für die Optik über die Soße streuen."
    }
  ]

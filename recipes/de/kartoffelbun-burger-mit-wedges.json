  "steps": [
    {
      "text": "Für die Buns die Kartoffeln schälen und 25 Minuten kochen.",
      "timerMinutes": 25
    },
    {
      "text": "Das Wasser abgießen, dann die Eier, Muskat, Pfeffer und Salz dazugeben und alles mit einem Pürierstab pürieren."
    },
    {
      "text": "Wenn die Masse kalt ist, 4 flache Bunhälften formen und je Seite 20 Minuten bei 160 °C in den Airfryer geben.",
      "timerMinutes": 20
    },
    {
      "text": "Für die Burgersauce Gewürzgurken und Chili klein schneiden und mit Mayonnaise, Tomatenmark, Balsamico, Honig, Oregano, Pfeffer und Salz vermischen."
    },
    {
      "text": "Für die Kartoffelecken die Kartoffeln waschen, vierteln und in eine Schüssel geben. Öl und Gewürze darüber geben und für 20 Minuten bei 200 °C in den Airfryer geben. Nach der Hälfte der Zeit wenden.",
      "timerMinutes": 20
    },
    {
      "text": "Salat waschen und die Blätter vom Strunk trennen. Zwiebel schälen und in Ringe schneiden. Tomate in Scheiben schneiden."
    },
    {
      "text": "In einer Pfanne den Bacon kross braten und dann auf Küchenpapier ablegen.",
      "timerMinutes": 5
    },
    {
      "text": "Das Hackfleisch zu vier gleich großen Patties formen und in die Pfanne mit dem Baconfett geben. Nach 3–4 Minuten wenden.",
      "timerMinutes": 3
    },
    {
      "text": "Zum Schluss die Patties mit Cheddar belegen und einen Deckel auf die Pfanne geben, damit der Cheddar schmilzt.",
      "timerMinutes": 2
    },
    {
      "text": "Die Sauce auf die unteren Bunhälften verteilen, Salat darüber, dann je 2 Patties und den Bacon stapeln. Darüber Zwiebelringe und Tomatenscheiben und die andere Bunhälfte obendrauf."
    }
  ]
}

  "steps": [
    {
      "text": "Zwiebel und Knoblauch schälen und klein hacken."
    },
    {
      "text": "In einer Pfanne Öl erhitzen und das Paprikapulver ins Öl mischen. Zwiebel und Knoblauch darin anbraten.",
      "timerMinutes": 3
    },
    {
      "text": "Jetzt den TK-Spinat und die Erbsen in die Pfanne geben und auftauen lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Die Lauchzwiebeln klein schneiden und mit den weißen Bohnen in die Pfanne geben. Mit Petersilie, Pfeffer und Salz würzen."
    },
    {
      "text": "4 Kuhlen in der Pfanne freimachen und in jede ein Ei schlagen."
    },
    {
      "text": "Den Feta darüberbröseln, einen Deckel auf die Pfanne setzen und alles 10 Minuten bei mittlerer Temperatur garen.",
      "timerMinutes": 10
    },
    {
      "text": "Währenddessen das Ciabatta toasten und mit Butter, Knoblauch, Salz und Schnittlauch belegen."
    }
  ]

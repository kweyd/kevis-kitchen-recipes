  "steps": [
    {
      "text": "Butter in einer Pfanne schmelzen lassen. Den Knoblauch schälen und in die Pfanne raspeln."
    },
    {
      "text": "Paniermehl und Sesam dazugeben und alles goldbraun werden lassen. Danach zur Seite stellen.",
      "timerMinutes": 4
    },
    {
      "text": "Nudeln kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Die Zwiebel schälen und klein schneiden. In einer großen Pfanne das Olivenöl erhitzen und die Zwiebel anbraten.",
      "timerMinutes": 3
    },
    {
      "text": "Tomatenmark dazugeben und etwas anrösten lassen. Die passierten Tomaten zusammen mit der Sahne in die Pfanne geben und mit Salz und Pfeffer würzen.",
      "timerMinutes": 2
    },
    {
      "text": "Etwas Nudelwasser in die Pfanne geben und die Nudeln abgießen. Anschließend die Nudeln in die Pfanne geben, den Parmesan darüberreiben und die gehackte Petersilie dazugeben. Alles umrühren und kurz in der Pfanne lassen."
    },
    {
      "text": "Servieren und den abgekühlten Knoblauch-Crunch über die Portionen verteilen."
    }
  ]
}

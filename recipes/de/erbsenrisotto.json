  "steps": [
    {
      "text": "Die Schalotten schälen und klein schneiden."
    },
    {
      "text": "In einem Topf Olivenöl erhitzen und die Schalotten anbraten.",
      "timerMinutes": 2
    },
    {
      "text": "Den Risottoreis in den Topf geben und mit dem Weißwein ablöschen."
    },
    {
      "text": "Die Gemüsebrühe anrühren und 100 ml davon mit 50 g der Erbsen pürieren."
    },
    {
      "text": "Die restliche Gemüsebrühe nach und nach zum Reis gießen, dabei auch die Brühe mit den pürierten Erbsen dazugeben.",
      "timerMinutes": 15
    },
    {
      "text": "In den letzten 5 Minuten die restlichen Erbsen dazugeben und mit Pfeffer und Salz abschmecken.",
      "timerMinutes": 5
    },
    {
      "text": "Zum Servieren 2 Esslöffel geriebenen Käse darübergeben."
    }
  ]

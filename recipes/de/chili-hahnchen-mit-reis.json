  "steps": [
    {
      "text": "Hähnchen, Chilis, Knoblauch und Zwiebel klein schneiden. Hähnchen und Chilis in eine Schüssel geben."
    },
    {
      "text": "Etwas Rapsöl darübersprühen, Paprikapulver, Knoblauch und Chilipulver dazugeben. Mit Pfeffer und Salz würzen, 1 EL Sesamsamen darüberstreuen und das Hähnchen mit allem marinieren.",
      "timerMinutes": 10
    },
    {
      "text": "Den Reis in einem Topf kochen.",
      "timerMinutes": 15
    },
    {
      "text": "In einer Pfanne den Schüsselinhalt zusammen mit der Zwiebel anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Paprika und Champignons klein schneiden und in die Pfanne geben. Bei Bedarf noch etwas Rapsöl darübersprühen und die restlichen 2 EL Sesamsamen dazugeben.",
      "timerMinutes": 6
    },
    {
      "text": "Für den Dip die Mayonnaise mit Ajvar, Olivenöl und Crispy Chili Öl mischen."
    },
    {
      "text": "Hähnchen-Gemüse mit Reis und Dip servieren."
    }
  ]

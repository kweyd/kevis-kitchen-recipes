  "steps": [
    {
      "text": "Karotte schälen und zusammen mit Paprika, Zucchini und Champignons klein schneiden."
    },
    {
      "text": "Hähnchen klein schneiden, mit etwas Öl, Pfeffer und Salz marinieren und für 2x 8 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 8
    },
    {
      "text": "Reis waschen und kochen.",
      "timerMinutes": 12
    },
    {
      "text": "Öl in einer Pfanne erhitzen und das klein geschnittene Gemüse anbraten. Den Rohrzucker dazugeben und 2 Minuten anschmoren.",
      "timerMinutes": 2
    },
    {
      "text": "Dann die Currypaste und Kurkuma (optional auch die gehackte Chili) dazugeben und ein paar weitere Minuten braten lassen.",
      "timerMinutes": 3
    },
    {
      "text": "Mit Kokosmilch und dem Saft einer Limette ablöschen und fünf Minuten köcheln lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Das Fleisch dazugeben und etwas ziehen lassen. Kurz vor Schluss den Pak Choi unterheben.",
      "timerMinutes": 3
    },
    {
      "text": "Mit Reis servieren und mit den Erdnüssen garnieren. Die 2. Limette nutzen, falls man mehr Limettenaroma haben will."
    }
  ]

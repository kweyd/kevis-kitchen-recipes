  "steps": [
    {
      "text": "Zwiebel kleinschneiden und mit der Butter in einer Pfanne anbräunen.",
      "timerMinutes": 3
    },
    {
      "text": "Den Risottoreis dazugeben und, wenn er leicht glasig wird, mit dem Weißwein ablöschen."
    },
    {
      "text": "Den Reis kochen lassen und immer wieder mit Gemüsebrühe auffüllen, bis der Reis mit Flüssigkeit bedeckt ist.",
      "timerMinutes": 20
    },
    {
      "text": "In einer anderen Pfanne die Shiitake-Pilze mit der Sojasoße anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Die Schokolade in kleine Stücke schneiden."
    },
    {
      "text": "Wenn die Flüssigkeit in der Pfanne mit dem Reis verkocht ist, das Risotto auf die Teller verteilen."
    },
    {
      "text": "Shiitake und Schokolade über die Portionen verteilen."
    }
  ]

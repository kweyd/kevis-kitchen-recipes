  "steps": [
    {
      "text": "Paprika waschen, Deckel abschneiden und innen aushöhlen."
    },
    {
      "text": "Reis kochen.",
      "timerMinutes": 12
    },
    {
      "text": "Währenddessen die Zwiebel und den Knoblauch schälen und klein hacken. Die Chili klein schneiden."
    },
    {
      "text": "Alles mit dem gekochten Reis, dem Hackfleisch, den Eiern und der Petersilie vermischen und mit Salz und Pfeffer würzen."
    },
    {
      "text": "Den Ofen auf 160 °C vorheizen."
    },
    {
      "text": "Die Paprika mit der Hackfleischmischung füllen und den Deckel daraufsetzen. Die Paprika aufrecht in eine Auflaufform stellen und in den Ofen geben.",
      "timerMinutes": 15
    },
    {
      "text": "Die passierten Tomaten mit Gemüsebrühe und Tomatenmark vermischen und für die letzten 15 Minuten mit in die Form geben. Den Käse darüberstreuen.",
      "timerMinutes": 15
    }
  ]

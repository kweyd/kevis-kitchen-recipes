  "steps": [
    {
      "text": "Den Reis kochen.",
      "timerMinutes": 12
    },
    {
      "text": "Für die Soße Abrieb und Saft der Orange mit Sojasoße, Wasser, Reisessig, Zucker, Sesamöl und Speisestärke in eine Schüssel geben und umrühren."
    },
    {
      "text": "Die Hähnchenbrust würfeln, mit Mehl bestreuen und in Milch und Paniermehl panieren."
    },
    {
      "text": "Die panierten Hähnchenstücke 16 Minuten bei 200 °C in den Airfryer geben. Nach 8 Minuten wenden.",
      "timerMinutes": 16
    },
    {
      "text": "Knoblauchzehe und Schalotte schälen, klein schneiden und in einem Topf mit Öl anbraten.",
      "timerMinutes": 2
    },
    {
      "text": "Die Soße aus der Schüssel dazugeben und aufkochen lassen, bis sie etwas dicker wird. Mit Pfeffer und Salz abschmecken.",
      "timerMinutes": 3
    },
    {
      "text": "Am Ende die Hähnchenstücke kurz unter die Soße heben."
    },
    {
      "text": "Den Reis auf die Teller geben, das Hähnchen mit Soße darauf verteilen und ein paar Lauchzwiebelstücke darüberstreuen."
    }
  ]

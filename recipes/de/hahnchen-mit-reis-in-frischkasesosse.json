  "steps": [
    {
      "text": "Den Reis waschen und kochen.",
      "timerMinutes": 12
    },
    {
      "text": "Währenddessen die Paprika klein schneiden. Die Hähnchenbrustfilets flach aufschneiden und in Öl von jeder Seite 3 Minuten anbraten.",
      "timerMinutes": 3
    },
    {
      "text": "Danach aus der Pfanne nehmen und mit Senf bestreichen. Den Bacon um die Hähnchenbrust legen und dünn mit Honig bestreichen."
    },
    {
      "text": "Die Hähnchenbrust mit der Paprika für 10 Minuten bei 200 °C in die Heißluftfritteuse geben.",
      "timerMinutes": 10
    },
    {
      "text": "Für die Soße Kräuterfrischkäse mit Milch, Sahne, Gemüsebrühe und etwas Pfeffer aufkochen.",
      "timerMinutes": 3
    },
    {
      "text": "Alles zusammen anrichten."
    }
  ]

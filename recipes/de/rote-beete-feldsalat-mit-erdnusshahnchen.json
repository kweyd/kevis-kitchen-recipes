  "steps": [
    {
      "text": "Den Feldsalat waschen und auf 2 Teller verteilen. Die Rote Bete schneiden und ebenfalls auf die beiden Teller verteilen."
    },
    {
      "text": "Ein Dressing aus Weißweinessig, Olivenöl, Pfeffer, Salz, Honig, frisch gepresstem Orangensaft und Wasser anrühren und über die Teller verteilen."
    },
    {
      "text": "Öl in einer Pfanne erhitzen, das Hähnchen in kleine Würfel schneiden und scharf anbraten.",
      "timerMinutes": 6
    },
    {
      "text": "Währenddessen die Linsen in einem Topf erhitzen.",
      "timerMinutes": 3
    },
    {
      "text": "Das Hähnchen in der Pfanne mit Sojasoße ablöschen, dann die Erdnussbutter dazugeben und umrühren, bis alles gleichmäßig verteilt ist. Jetzt noch den Sesam dazugeben und weiterrühren."
    },
    {
      "text": "Die Linsen auf die Teller verteilen und das Hähnchen obendrauf geben."
    }
  ]

  "steps": [
    {
      "text": "Den Ofen auf 180 °C vorheizen."
    },
    {
      "text": "Den Feta in eine Auflaufform geben. Knoblauch schälen und klein schneiden, Kirschtomaten halbieren."
    },
    {
      "text": "Beides zum Feta in die Auflaufform geben, Olivenöl darüber träufeln und für 20 Minuten in den Ofen geben.",
      "timerMinutes": 20
    },
    {
      "text": "Währenddessen Wasser in einem Topf aufkochen und die Nudeln darin kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Die Auflaufform aus dem Ofen holen und alles mit einer Gabel zerdrücken."
    },
    {
      "text": "Mit Salz, Pfeffer und italienischen Kräutern würzen."
    },
    {
      "text": "Die Nudeln abgießen und in der Auflaufform mit der Soße vermischen."
    }
  ]

  "steps": [
    {
      "text": "Paprika, Zwiebel, Chili, Knoblauch, Tofu, Blumenkohl und Pak Choi mundgerecht klein schneiden."
    },
    {
      "text": "Alles in einem Topf mit etwas Öl anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Die Currypaste mit in den Topf geben und kurz anrösten.",
      "timerMinutes": 1
    },
    {
      "text": "Kokosmilch, Kichererbsen und Gemüsebrühe dazugeben und aufkochen lassen. Mit Pfeffer und Salz abschmecken.",
      "timerMinutes": 5
    },
    {
      "text": "Währenddessen die Reisnudeln kochen. Die Reisnudeln abschrecken und mit in den Topf geben.",
      "timerMinutes": 5
    },
    {
      "text": "Die Erdnüsse über die Portionen geben."
    }
  ]

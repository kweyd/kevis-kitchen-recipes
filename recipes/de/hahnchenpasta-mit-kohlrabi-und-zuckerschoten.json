  "steps": [
    {
      "text": "Die Hähnchenbrust in Stücke schneiden. Kohlrabi schälen und würfeln. Zuckerschoten waschen."
    },
    {
      "text": "Die Nudeln in einem Topf kochen.",
      "timerMinutes": 8
    },
    {
      "text": "Die Hähnchenbrust nach Belieben marinieren und für 2x 9 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 18
    },
    {
      "text": "Die Butter in einer Pfanne erwärmen und den Kohlrabi darin dünsten.",
      "timerMinutes": 6
    },
    {
      "text": "Die Zuckerschoten hinzugeben und mit der Kochsahne ablöschen. Die Gemüsebrühe einrühren.",
      "timerMinutes": 3
    },
    {
      "text": "Den Parmesan zur Soße geben und mit Pfeffer und Salz abschmecken."
    },
    {
      "text": "Die Nudeln und das Hähnchen noch kurz mit in die Pfanne geben."
    }
  ]

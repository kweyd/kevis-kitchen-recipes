  "steps": [
    {
      "text": "Hähnchenbrust klein schneiden. Knoblauch schälen und pressen."
    },
    {
      "text": "Das Hähnchen mit 15 ml Olivenöl, Knoblauch, Chilipulver, Paprikapulver und einem Esslöffel Sesam marinieren."
    },
    {
      "text": "Reis zusammen mit der Butter in einem Topf kochen.",
      "timerMinutes": 15
    },
    {
      "text": "Das marinierte Hähnchen für 18 Minuten bei 200 °C in den Airfryer geben. Nach der Hälfte umdrehen.",
      "timerMinutes": 18
    },
    {
      "text": "Paprika, Zwiebel und Champignons kleinschneiden. Alles mit etwas Öl in einer Pfanne anbraten.",
      "timerMinutes": 8
    },
    {
      "text": "Ajvar mit Mayonnaise, 5 ml Olivenöl und Crispy Chili Oil mischen."
    },
    {
      "text": "Lauchzwiebel klein schneiden und alles zusammen servieren, mit dem restlichen Sesam bestreut."
    }
  ]

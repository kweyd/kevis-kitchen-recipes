  "steps": [
    {
      "text": "Kartoffeln waschen und in mundgerechte Stücke schneiden."
    },
    {
      "text": "Den Ofen auf 220 °C vorheizen."
    },
    {
      "text": "Die Kartoffeln in einer Schüssel mit 2 EL Olivenöl, gehacktem Knoblauch, Paprikapulver und Rosmarin marinieren."
    },
    {
      "text": "Die Kartoffeln auf einem Backblech mit Backpapier verteilen und für 25 Minuten in den Ofen geben.",
      "timerMinutes": 25
    },
    {
      "text": "Die Linsen mit 300 ml Wasser in einen Topf geben und 20 Minuten kochen lassen.",
      "timerMinutes": 20
    },
    {
      "text": "Linsen und Kartoffeln in eine Schüssel geben und klein gehackten Dill und Petersilie darüber streuen."
    },
    {
      "text": "Den Spinat dazugeben."
    },
    {
      "text": "Für das Dressing das restliche Olivenöl mit Honig, Senf, Balsamico, Pfeffer und Salz vermischen und über den Salat geben."
    }
  ]

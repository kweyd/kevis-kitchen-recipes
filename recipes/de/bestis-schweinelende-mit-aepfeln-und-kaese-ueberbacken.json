  "steps": [
    {
      "text": "Den Backofen auf 225 °C Ober-/Unterhitze vorheizen."
    },
    {
      "text": "Die Schweinelende von Sehnen und Silberhaut befreien, in dicke Scheiben schneiden und salzen. In etwas Öl scharf anbraten."
    },
    {
      "text": "Die Äpfel schälen, entkernen und in Scheiben schneiden. Die Zwiebel schälen und ebenfalls in Scheiben schneiden."
    },
    {
      "text": "Die angebratenen Fleischscheiben pfeffern und zusammen mit den Zwiebeln und Äpfeln in eine Auflaufform schichten. Rosmarin nach Geschmack dazugeben."
    },
    {
      "text": "Die Sahne mit Ketchup, Senf, Mehl und Currypulver gut verrühren. Über die geschichteten Zutaten gießen."
    },
    {
      "text": "Mit geriebenem Käse bedecken und im vorgeheizten Ofen etwa 30 Minuten backen.",
      "timerMinutes": 30
    }
  ]

  "steps": [
    {
      "text": "Die Nudeln in einem Topf kochen.",
      "timerMinutes": 8
    },
    {
      "text": "Das Hähnchenbrustfilet in Stücke schneiden und in einer Schüssel mit Olivenöl, einem Drittel des Parmesans, Paprikapulver, Pfeffer und Salz marinieren."
    },
    {
      "text": "Das Hähnchen in einer Pfanne von allen Seiten scharf anbraten und dann aus der Pfanne nehmen.",
      "timerMinutes": 6
    },
    {
      "text": "Den Knoblauch kleinschneiden und mit etwas Öl in derselben Pfanne anbraten.",
      "timerMinutes": 1
    },
    {
      "text": "Mit der Kochsahne ablöschen und Petersilie, Basilikum, Kräuterfrischkäse und den restlichen Parmesan dazugeben."
    },
    {
      "text": "Mit Salz und Pfeffer abschmecken und die Nudeln nach dem Abgießen mit in die Pfanne geben."
    },
    {
      "text": "Zusammen mit dem Hähnchen servieren."
    }
  ]

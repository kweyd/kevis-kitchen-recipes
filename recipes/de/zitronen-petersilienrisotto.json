  "steps": [
    {
      "text": "Die Zwiebel schälen und hacken. Den Parmesan reiben."
    },
    {
      "text": "In einer Pfanne die Zwiebel in etwas Öl andünsten und kurz danach den Risottoreis dazugeben.",
      "timerMinutes": 3
    },
    {
      "text": "Bevor der Risottoreis anbrennt, mit Weißwein ablöschen."
    },
    {
      "text": "Den Weißwein verkochen lassen und währenddessen die Petersilie zusammen mit dem Saft und dem Abrieb einer Zitrone, Pinienkernen, Olivenöl, der Hälfte vom Parmesan, Pfeffer und Salz zu einem Pesto mixen.",
      "timerMinutes": 5
    },
    {
      "text": "Wenn der Weißwein fast verkocht ist, die Pfanne immer wieder mit der Gemüsebrühe auffüllen, bis der Reis bedeckt ist.",
      "timerMinutes": 20
    },
    {
      "text": "Wenn fast alle Flüssigkeit weg ist, den Reis mit dem Pesto mischen und mit dem restlichen Parmesan servieren."
    }
  ]

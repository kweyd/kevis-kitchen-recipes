  "steps": [
    {
      "text": "Zucchini waschen und mit einem Sparschäler in Streifen schneiden."
    },
    {
      "text": "Zwiebel und Knoblauch schälen und kleinschneiden."
    },
    {
      "text": "In einer Schüssel Rinderhack, Salami, Ei, geriebenen Käse, Pfeffer, Salz und die Hälfte von Knoblauch, Zwiebel und Parmesan vermengen und zu kleinen Bällchen rollen."
    },
    {
      "text": "In einer Pfanne Öl erhitzen und die Hackbällchen braun anbraten. Dann herausnehmen.",
      "timerMinutes": 6
    },
    {
      "text": "Den Rest der Zwiebeln und des Knoblauchs in der Pfanne anbraten. Passierte und stückige Tomaten sowie Tomatenmark dazugeben."
    },
    {
      "text": "Mit Essig, Honig, Oregano und gerebeltem Basilikum würzen. Gegebenenfalls noch etwas Pfeffer und Salz dazugeben."
    },
    {
      "text": "Die Fleischbällchen mit in die Soße geben und alles 10 Minuten köcheln lassen.",
      "timerMinutes": 10
    },
    {
      "text": "In einer anderen Pfanne die Zoodles mit etwas Öl andünsten.",
      "timerMinutes": 3
    },
    {
      "text": "Anrichten und den restlichen Parmesan und das frische Basilikum über die Portionen verteilen."
    }
  ]
}

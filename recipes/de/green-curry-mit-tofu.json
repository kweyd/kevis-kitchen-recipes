  "steps": [
    {
      "text": "Den Brokkoli in kleine Röschen teilen, die Frühlingszwiebel in kleine Ringe schneiden und die Zuckerschoten waschen."
    },
    {
      "text": "Den Reis nach Packungsangabe kochen.",
      "timerMinutes": 15
    },
    {
      "text": "Knoblauch und Ingwer klein hacken."
    },
    {
      "text": "Das Rapsöl in einem Topf erhitzen und Knoblauch, Ingwer, Currypaste und die Gewürze kurz rösten.",
      "timerMinutes": 1
    },
    {
      "text": "Brokkoli, Frühlingszwiebel, Zuckerschoten und Zitronenabrieb hinzugeben und mit Kokosmilch und etwas Wasser auffüllen."
    },
    {
      "text": "Bei mittlerer Hitze 15 Minuten kochen lassen.",
      "timerMinutes": 15
    },
    {
      "text": "Inzwischen den Tofu kleinschneiden, nach Belieben marinieren und für 12 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 12
    },
    {
      "text": "Das Curry mit Reis und Tofu servieren."
    }
  ]

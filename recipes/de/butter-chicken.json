  "steps": [
    {
      "text": "Hähnchen in mundgerechte Stücke schneiden und in einer Schüssel mit der Currypaste und dem Joghurt marinieren."
    },
    {
      "text": "Die Zwiebel schälen und klein schneiden."
    },
    {
      "text": "Die Butter in einer Pfanne schmelzen und den Knoblauch in die Pfanne pressen. Die Zwiebel dazugeben und anbraten.",
      "timerMinutes": 4
    },
    {
      "text": "Piment, Zimt und Kardamom mit in die Pfanne geben."
    },
    {
      "text": "Den Reis in einem Topf kochen.",
      "timerMinutes": 15
    },
    {
      "text": "Das Hähnchen mit Marinade für 2x 8 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 16
    },
    {
      "text": "Tomatenmark in die Pfanne geben und leicht anrösten. 50 ml Wasser und die Kochsahne dazugeben.",
      "timerMinutes": 2
    },
    {
      "text": "Mit Pfeffer und Salz abschmecken und das Hähnchen mit Marinade in die Soße einrühren."
    }
  ]

  "steps": [
    {
      "text": "Den Backofen auf 150 °C vorheizen."
    },
    {
      "text": "Die Sahne mit dem Eigelb und der Milch verquirlen."
    },
    {
      "text": "Anschließend das Vanillemark, den Zucker und den Zitronenabrieb dazugeben und alles wieder mischen."
    },
    {
      "text": "Die Flüssigkeit in die Förmchen gießen und in einer Fettpfanne, die mit kochendem Wasser gefüllt ist, 55 Minuten bei 150 °C in den vorgeheizten Ofen stellen.",
      "timerMinutes": 55
    },
    {
      "text": "Die Förmchen über Nacht in den Kühlschrank stellen."
    },
    {
      "text": "Erst kurz vor dem Servieren jedes Förmchen gleichmäßig mit je einem Esslöffel Zucker bestreuen und den Zucker mit einem Brenner karamellisieren."

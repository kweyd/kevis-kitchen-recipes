  "steps": [
    {
      "text": "Das Rinderfilet vakuumieren und bei 52 °C für 90 Minuten sous vide garen.",
      "timerMinutes": 90
    },
    {
      "text": "Maronen, Champignons, Thymianblättchen, Knoblauch und Weißwein in einen Mixer geben und fein zerkleinern."
    },
    {
      "text": "Die Masse ohne Öl in eine Pfanne geben und die Flüssigkeit verdampfen lassen.",
      "timerMinutes": 10
    },
    {
      "text": "Klarsichtfolie auslegen und den Schinken darauf drapieren. Die Masse aus der Pfanne darauf verteilen."
    },
    {
      "text": "Das Rinderfilet mit Salz und Pfeffer würzen, in einer Pfanne mit etwas Öl rundherum scharf anbraten und mit Senf einreiben.",
      "timerMinutes": 3
    },
    {
      "text": "Das Filet auf die Masse mit dem Schinken legen, mithilfe der Folie einrollen und für mindestens 15 Minuten in den Kühlschrank legen.",
      "timerMinutes": 15
    },
    {
      "text": "Wieder Klarsichtfolie auslegen und den Blätterteig darauf ausrollen."
    },
    {
      "text": "Das Filet ohne Folie auf den Blätterteig legen, ebenfalls einrollen und wieder für mindestens 15 Minuten in den Kühlschrank legen.",
      "timerMinutes": 15
    },
    {
      "text": "Den Ofen auf 200 °C vorheizen."
    },
    {
      "text": "Den Blätterteig mit dem Eigelb bestreichen und für 22 Minuten in den Ofen geben.",
      "timerMinutes": 22
    }
  ]
}

  "steps": [
    {
      "text": "Den Ofen auf 220 °C vorheizen. Kartoffeln schälen und in sehr dünne Scheiben schneiden."
    },
    {
      "text": "Den Rosmarin fein hacken."
    },
    {
      "text": "Mehl mit 100 ml Wasser, Olivenöl und etwas Salz gründlich verkneten."
    },
    {
      "text": "Den Teig ausrollen und auf ein Backblech mit Backpapier legen."
    },
    {
      "text": "Frischkäse mit italienischen Kräutern auf dem Teig verteilen."
    },
    {
      "text": "Die Kartoffelscheiben leicht überlappend darauf verteilen. Rosmarin und Parmesan darüberstreuen und mit Pfeffer würzen."
    },
    {
      "text": "Im Ofen bei 220 °C 14 Minuten backen.",
      "timerMinutes": 14
    }
  ]

  "steps": [
    {
      "text": "Mehl, Salz, Pflanzenöl und Eigelb in eine Schüssel geben und 250 ml Wasser nach und nach beim Kneten zugeben."
    },
    {
      "text": "Den Teig mindestens 2 Stunden im Kühlschrank ruhen lassen.",
      "timerMinutes": 120
    },
    {
      "text": "Für die Füllung Zwiebel, Knoblauch und Chilischoten fein würfeln, Petersilie waschen, trocken schütteln und fein hacken."
    },
    {
      "text": "Alles mit dem Hackfleisch vermischen. Mit Salz, Pfeffer und Cayennepfeffer würzen."
    },
    {
      "text": "Eine Messerspitze Rinderbrühepulver hinzufügen und mit ca. 2 Tassen Wasser in einer Schüssel vermengen. Ebenfalls mindestens 2 Stunden im Kühlschrank ziehen lassen.",
      "timerMinutes": 120
    },
    {
      "text": "Den Teig auf einer bemehlten Arbeitsfläche dünn ausrollen und Kreise mit ca. 10–15 cm Durchmesser ausstechen."
    },
    {
      "text": "Je 1 EL Füllung mittig auf einen Teigkreis geben. Den Teig nach oben klappen, dabei kleine Falten schlagen und oben fest zusammendrehen."
    },
    {
      "text": "Die Teigtaschen in kochendem Salzwasser auf mittlerer Hitze 10 Minuten kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Einzeln aus dem Wasser holen und mit eiskaltem Wasser abschrecken."
    }
  ]
}

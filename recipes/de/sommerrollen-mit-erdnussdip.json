  "steps": [
    {
      "text": "Paprika, Karotten, Rotkohl und Gurke in Streifen schneiden."
    },
    {
      "text": "Den Tofu klein schneiden, mit etwas Öl besprühen und für 2x 8 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 16
    },
    {
      "text": "Für die Soße Knoblauch und Ingwer klein schneiden und die Limette auspressen."
    },
    {
      "text": "Alles mit Erdnussbutter, Honig, 3 EL Wasser, Kokosmilch, Sojasoße und Reisessig zu einer Soße verrühren."
    },
    {
      "text": "Einen Teller mit lauwarmem Wasser bedecken und das Reispapier jeweils von beiden Seiten kurz aufweichen."
    },
    {
      "text": "Das Reispapier auf einem trockenen Teller mit Gemüse und Tofu belegen, mit Sesam bestreuen und aufrollen."
    }
  ]

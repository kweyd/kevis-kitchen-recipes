  "steps": [
    {
      "text": "Die roten Zwiebeln und den Knoblauch schälen und klein hacken."
    },
    {
      "text": "Anschließend in Öl anbraten. Einen halben Teelöffel Honig dazugeben, um die Zwiebeln leicht zu karamellisieren.",
      "timerMinutes": 5
    },
    {
      "text": "Die Kirschtomaten halbieren und mit dem Spinat in die Pfanne geben. Warten, bis der Spinat eingefallen ist.",
      "timerMinutes": 2
    },
    {
      "text": "50 ml Wasser mit einem halben Teelöffel Gemüsebrühe mischen und zusammen mit den Gnocchi in die Pfanne geben."
    },
    {
      "text": "Nach Bedarf mit Pfeffer und Salz würzen und 5 Minuten kochen lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Am Ende etwas Parmesan und Basilikum darübergeben und servieren."
    }
  ]

  "steps": [
    {
      "text": "Reis nach Packungsanleitung kochen.",
      "timerMinutes": 15
    },
    {
      "text": "Brokkoli waschen, klein schneiden und 10 Minuten in Salzwasser kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Lachs mit Salz und Pfeffer würzen. 2 Scheiben Zitrone auf jedes Lachsstück legen und für 20 Minuten bei 160 °C in den Airfryer geben.",
      "timerMinutes": 20
    },
    {
      "text": "Currypaste in eine Pfanne geben und anrösten lassen.",
      "timerMinutes": 1
    },
    {
      "text": "Mit Kokosmilch ablöschen und kurz köcheln lassen.",
      "timerMinutes": 3
    },
    {
      "text": "Das Wasser vom Brokkoli abgießen, Schlagsahne, Muskatnuss, Pfeffer und Salz dazugeben und alles pürieren."
    },
    {
      "text": "Alles zusammen mit den Zitronenscheiben servieren."
    }
  ]

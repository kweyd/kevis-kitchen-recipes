  "steps": [
    {
      "text": "Schalotten und Champignons kleinschneiden und in einer Pfanne mit etwas Öl anbraten.",
      "timerMinutes": 4
    },
    {
      "text": "Die Gnocchi und die Rinderbrühe dazugeben und köcheln lassen.",
      "timerMinutes": 10
    },
    {
      "text": "Das Rinderfilet mit Pfeffer und Salz würzen und 2 Minuten von allen Seiten scharf anbraten.",
      "timerMinutes": 2
    },
    {
      "text": "Anschließend für 10 Minuten bei 150 °C in den Airfryer geben.",
      "timerMinutes": 10
    },
    {
      "text": "Die Kochsahne in die Pfanne mit den Champignons geben und mit Pfeffer, Salz und Petersilie abschmecken."
    },
    {
      "text": "Das Rinderfilet in Scheiben schneiden und auf den Gnocchi servieren."
    }
  ]

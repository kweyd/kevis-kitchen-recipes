  "steps": [
    {
      "text": "Kartoffeln schälen und in mundgerechte Stücke schneiden."
    },
    {
      "text": "Die Kartoffeln in einem Topf mit Wasser und Salz kochen.",
      "timerMinutes": 20
    },
    {
      "text": "In einer Schüssel Hackfleisch, klein geschnittenen Bacon, Paniermehl, Ei, klein geschnittene Zwiebel, klein gehackten Knoblauch, Chilipulver, Paprikapulver, Pfeffer und Salz vermengen."
    },
    {
      "text": "In einer Pfanne Öl erhitzen, aus dem Hackfleisch kleine Bällchen formen und diese anbraten.",
      "timerMinutes": 8
    },
    {
      "text": "Die Erbsen und Möhren dazugeben und mit Rinderbrühe ablöschen."
    },
    {
      "text": "Nach ein paar Minuten die Sahne dazugeben und kurz aufkochen lassen. Gegebenenfalls etwas Speisestärke dazugeben.",
      "timerMinutes": 5
    },
    {
      "text": "Mit Pfeffer, Salz, Paprikapulver und Petersilie abschmecken."
    },
    {
      "text": "Die Kartoffeln abgießen und servieren."
    }
  ]
}

  "steps": [
    {
      "text": "Beim Brokkoli die Röschen vom Strunk trennen und den Strunk klein schneiden."
    },
    {
      "text": "Zwiebel und Knoblauch schälen und hacken."
    },
    {
      "text": "In einem Topf ein Drittel der Butter erhitzen und die Zwiebel mit dem Brokkolistrunk anbraten.",
      "timerMinutes": 4
    },
    {
      "text": "Den Knoblauch dazugeben und warten, bis er leicht braun ist.",
      "timerMinutes": 2
    },
    {
      "text": "Dann mit der Gemüsebrühe ablöschen und mit Pfeffer und Salz abschmecken."
    },
    {
      "text": "Mit einem Pürierstab alles zu einer sämigen Masse pürieren und kochen lassen.",
      "timerMinutes": 10
    },
    {
      "text": "In einem anderen Topf die Brokkoliröschen mit der restlichen Butter anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Wenn der Brokkoli leicht braun ist, die sämige Masse sowie die Schlagsahne und den Cheddar dazugeben und unter Rühren so lange kochen, bis der Cheddar geschmolzen ist.",
      "timerMinutes": 3
    }
  ]
}

  "steps": [
    {
      "text": "Quark in eine Schüssel geben und mit der Milch verrühren."
    },
    {
      "text": "Apfel bei Bedarf zunächst schälen oder alternativ mit Schale belassen, diesen vierteln. Apfelstücke in kleine Scheibchen schneiden und in eine kleine Pfanne geben."
    },
    {
      "text": "Pfanne erhitzen und sobald das erste Zischen vom Apfel zu hören ist, Hitze auf mittleren Wert stellen."
    },
    {
      "text": "Zimt und Honig in die Pfanne geben und mit den Apfelstückchen verrühren. Anschließend etwa 5 Minuten erhitzen, bis die Äpfel etwas weicher geworden und der Honig zerlaufen ist.",
      "timerMinutes": 5
    },
    {
      "text": "Apfel auf den Quark in die Schüssel geben und mit dem Müsli toppen."
    },
    {
      "text": "Erdnussmus als letztes Topping oben drauf geben und die Mahlzeit genießen! ☺️"
    }

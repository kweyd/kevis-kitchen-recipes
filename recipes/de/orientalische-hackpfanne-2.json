  "steps": [
    {
      "text": "Zwiebel, Knoblauch und Chilischote fein hacken. Paprika in Streifen schneiden."
    },
    {
      "text": "Die Zwiebel in einer Pfanne mit etwas Öl anbraten, das Hackfleisch dazugeben und krümelig braten.",
      "timerMinutes": 6
    },
    {
      "text": "2 Zehen Knoblauch, Chili und Paprika zum Hackfleisch geben. Anschließend das Tomatenmark unterrühren und mit Paprikapulver, Salz und Pfeffer abschmecken.",
      "timerMinutes": 4
    },
    {
      "text": "75 ml Wasser dazugeben und ein paar Minuten kochen lassen.",
      "timerMinutes": 3
    },
    {
      "text": "Die Kichererbsen und den kleingeschnittenen Feta unterheben und erwärmen lassen."
    },
    {
      "text": "Den Schmand mit dem Saft der halben Zitrone, 3 Zehen Knoblauch, Honig, Petersilie, Pfeffer und Salz vermischen und zur Hackpfanne servieren."
    }
  ]

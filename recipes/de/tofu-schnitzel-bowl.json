  "steps": [
    {
      "text": "Reis kochen.",
      "timerMinutes": 12
    },
    {
      "text": "Währenddessen Knoblauch schälen und klein schneiden. Zucchini in dünne Scheiben schneiden. Lauchzwiebel in Ringe, Limetten in Viertel und die geschälte Avocado in Streifen schneiden."
    },
    {
      "text": "In einer Schüssel die Sweet-Chili-Sauce mit 150 ml Wasser, Honig, Sojasauce, etwas Pfeffer und Speisestärke mischen."
    },
    {
      "text": "Eine Pfanne mit Öl erhitzen und Knoblauch und Zucchini anbraten.",
      "timerMinutes": 4
    },
    {
      "text": "Ei mit Pfeffer und Salz in einem Teller verrühren, in einen anderen Teller das Panko-Paniermehl geben. Den Tofu ausdrücken und mittig durchschneiden, sodass zwei flache Schnitzel entstehen. In beiden Tellern panieren, dabei die Stationen am besten doppelt durchlaufen."
    },
    {
      "text": "Die Lauchzwiebelringe mit dem Saft der Limetten und den Erdnüssen mischen."
    },
    {
      "text": "Die Zucchini in der Pfanne mit der Sweet-Chili-Sauce ablöschen und köcheln lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Die panierten Tofuschnitzel bei 200 °C von jeder Seite 4 Minuten frittieren.",
      "timerMinutes": 4
    },
    {
      "text": "Reis auf den Tellern anrichten, darüber die Zucchini in der Sweet-Chili-Sauce. Darauf die Avocadostreifen und die Mischung aus Erdnüssen, Lauchzwiebeln und Limettensaft verteilen. Die Schnitzel in Stücke schneiden und obendrauf geben."
    }
  ]

  "steps": [
    {
      "text": "Die Mie-Nudeln mit kochendem Wasser übergießen und ziehen lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Knoblauch, Ingwer und Zwiebel schälen und klein hacken. Die Karotten schälen und in mundgerechte Scheiben schneiden, Rotkohl und Lauchzwiebel in feine Streifen schneiden. Den Tofu würfeln."
    },
    {
      "text": "In einer großen Schüssel die Sojasoße mit dem Cashewmus und dem Agavendicksaft zu einer Soße verrühren."
    },
    {
      "text": "Die Nudeln abgießen und unter die Soße heben."
    },
    {
      "text": "Öl in einer Pfanne erhitzen und die Zwiebel anbraten. Anschließend Ingwer und Knoblauch dazugeben.",
      "timerMinutes": 3
    },
    {
      "text": "Wenn der Knoblauch leicht angebraten ist, die Karotten und den Tofu dazugeben.",
      "timerMinutes": 5
    },
    {
      "text": "Wenn alles etwas gebraten hat, die Nudeln unterheben und kurz mit anbraten.",
      "timerMinutes": 2
    },
    {
      "text": "Zum Servieren den Pfanneninhalt auf die Teller verteilen und Sesam, Lauchzwiebel, Rotkohl und Chiliflocken darüberstreuen."
    }
  ]

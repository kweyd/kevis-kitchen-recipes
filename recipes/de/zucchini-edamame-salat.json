  "steps": [
    {
      "text": "Zucchini waschen, halbieren und in Scheiben schneiden. Knoblauch schälen und klein hacken."
    },
    {
      "text": "Salat und Pilze waschen und die Pilze in Scheiben schneiden."
    },
    {
      "text": "2 EL Olivenöl in einer Pfanne erhitzen und Knoblauch, Zucchini und Champignons in die Pfanne geben. Die Sojasauce dazugeben und etwas anbraten lassen.",
      "timerMinutes": 6
    },
    {
      "text": "Den Salat mit Edamame und Pistazien in eine Schüssel geben."
    },
    {
      "text": "Für das Dressing den Saft der Orange mit 1 EL Olivenöl, dem Balsamico-Essig, Honig, Pfeffer und Salz mischen. Das Dressing in die Schüssel geben und alles verrühren."
    },
    {
      "text": "Den Salat auf die Teller verteilen und den Inhalt der Pfanne darübergeben."
    }
  ]

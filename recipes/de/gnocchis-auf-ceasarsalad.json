  "steps": [
    {
      "text": "Knoblauch schälen und kleinschneiden. Kirschtomaten halbieren."
    },
    {
      "text": "Kirschtomaten mit etwas Öl und Salz bestreuen und zusammen mit der Hälfte vom Knoblauch bei 200 °C für 12 Minuten in den Airfryer geben.",
      "timerMinutes": 12
    },
    {
      "text": "Die Gnocchi bei 200 °C für 12 Minuten in den Airfryer geben. Wer keinen Airfryer mit 2 Kammern hat, kann die Gnocchi auch mit etwas Öl in einer Pfanne braten.",
      "timerMinutes": 12
    },
    {
      "text": "Für das Dressing die Hälfte vom geriebenen Käse mit dem restlichen Knoblauch, Mayonnaise, Naturjoghurt, Rotweinessig, Sojasoße und Senf pürieren. Mit Pfeffer und Salz abschmecken."
    },
    {
      "text": "Beim Römersalat den Strunk entfernen, den Salat waschen und alles in einer großen Schüssel zusammenführen."
    },
    {
      "text": "Den restlichen geriebenen Käse und den Schnittlauch zum Garnieren über die Portionen geben."
    }
  ]

  "steps": [
    {
      "text": "Zwiebel, Knoblauch, Paprika und Chili klein schneiden."
    },
    {
      "text": "Öl in einer Pfanne erhitzen und die Zwiebel glasig anbraten.",
      "timerMinutes": 3
    },
    {
      "text": "Hackfleisch dazugeben und krümelig anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Paprika, die Hälfte vom Knoblauch und die Chili dazugeben und anbraten.",
      "timerMinutes": 3
    },
    {
      "text": "Tomatenmark, Paprikapulver, Pfeffer und Salz dazugeben. Nach zwei Minuten 75 ml Wasser dazugießen und aufkochen lassen.",
      "timerMinutes": 2
    },
    {
      "text": "Kichererbsen und klein geschnittenen Feta unterrühren."
    },
    {
      "text": "Für den Dip den Joghurt mit dem restlichen Knoblauch, Honig und Schnittlauch verrühren und mit Pfeffer und Salz abschmecken."
    }
  ]

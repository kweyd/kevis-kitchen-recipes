  "steps": [
    {
      "text": "Eine Pfanne ohne Öl erhitzen und den Bacon darin knusprig braten. Währenddessen Salat und Tomate klein schneiden.",
      "timerMinutes": 5,
      "ingredients": [
        {
          "ingredient": 2
        },
        {
          "ingredient": 4
        },
        {
          "ingredient": 3
        }
      ]
    },
    {
      "text": "Für die Soße die Mayonnaise mit Tomatenmark, Balsamico-Essig, Honig, Oregano, Pfeffer und Salz mischen. Die Cornichons klein schneiden und ebenfalls in die Soße geben.",
      "ingredients": [
        {
          "ingredient": 6
        },
        {
          "ingredient": 7
        },
        {
          "ingredient": 8
        },
        {
          "ingredient": 9
        },
        {
          "ingredient": 11
        },
        {
          "ingredient": 12
        },
        {
          "ingredient": 13
        },
        {
          "ingredient": 10
        }
      ]
    },
    {
      "text": "Das Rinderhackfleisch ungewürzt zu zwei länglichen Patties formen. Den knusprigen Bacon aus der Pfanne nehmen und dafür die Patties hineinlegen.",
      "ingredients": [
        {
          "ingredient": 1
        }
      ]
    },
    {
      "text": "Die Patties von beiden Seiten braten. Für die letzte Minute den Cheddar darauflegen und unter einem Deckel schmelzen lassen.",
      "timerMinutes": 6,
      "ingredients": [
        {
          "ingredient": 5
        }
      ]
    },
    {
      "text": "Die Croissants aufschneiden und beide Seiten mit der Soße bestreichen. Auf die Unterseite Salat, dann Patty, Tomaten und Bacon legen und zuklappen.",
      "ingredients": [
        {
          "ingredient": 0
        }
      ]
    },
    {
      "text": "Die Süßkartoffel schälen und in 1 cm dicke Streifen schneiden. Für knusprigere Pommes die Streifen vor dem Würzen 30 Minuten in kaltes Wasser legen und gut abtrocknen.",
      "timerMinutes": 30,
      "ingredients": [
        {
          "ingredient": 14
        }
      ]
    },
    {
      "text": "Die Streifen in einer Schüssel mit etwas Öl, Salz und gepresstem Knoblauch mischen und 2 × 10 Minuten bei 190 °C in den Airfryer geben.",
      "timerMinutes": 20,
      "ingredients": [
        {
          "ingredient": 15
        },
        {
          "ingredient": 13
        },
        {
          "ingredient": 16,
          "share": 0.4
        }
      ]
    },
    {
      "text": "Für den Dip die Butter in einer Pfanne erhitzen. Gepressten Knoblauch hineingeben und die Pfanne vom Herd nehmen, bevor der Knoblauch braun wird.",
      "timerMinutes": 2,
      "ingredients": [
        {
          "ingredient": 17
        },
        {
          "ingredient": 16,
          "share": 0.6
        }
      ]
    },
    {
      "text": "Den Weißweinessig dazugeben, den Parmesan und etwas Petersilie einrühren und gut weiterrühren. Am besten ein Küchengerät nutzen, sonst dauert es lange, bis eine homogene Masse entsteht.",
      "ingredients": [
        {
          "ingredient": 19
        },
        {
          "ingredient": 18
        },
        {
          "ingredient": 20
        }
      ]
    },
    {
      "text": "Beim Servieren ein paar geschnittene Lauchzwiebeln über den Dip streuen.",
      "ingredients": [
        {
          "ingredient": 21
        }
      ]
    }
  ]
}

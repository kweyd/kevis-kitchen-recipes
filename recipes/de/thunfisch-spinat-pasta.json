  "steps": [
    {
      "text": "Die Nudeln kochen.",
      "timerMinutes": 9
    },
    {
      "text": "Zwiebel und Knoblauch schälen und klein hacken."
    },
    {
      "text": "Eine Pfanne mit Öl erhitzen und die Zwiebel anbraten.",
      "timerMinutes": 3
    },
    {
      "text": "Wenn die Zwiebel angebraten ist, den Spinat und den Knoblauch dazugeben.",
      "timerMinutes": 5
    },
    {
      "text": "Wenn der Spinat aufgetaut ist, einen Löffel Nudelwasser in die Pfanne geben und den Thunfisch unterheben."
    },
    {
      "text": "Die Temperatur etwas herunterstellen und Abrieb und Saft der Zitrone in die Pfanne geben. Mit Pfeffer und Salz abschmecken."
    },
    {
      "text": "Die Nudeln abgießen und in die Pfanne einrühren."
    },
    {
      "text": "Anschließend auf Teller verteilen und den Mozzarella in Stücken über die Portionen verteilen."
    }

  "steps": [
    {
      "text": "Etwas Olivenöl in eine Schüssel geben. Knoblauch schälen und in die Schüssel pressen. Den Abrieb einer Zitrone und den Saft von 1,5 Zitronen zusammen mit 25 ml Milch, Salz und Pfeffer dazugeben."
    },
    {
      "text": "Das Hähnchenbrustfilet in dünne Schnitzel schneiden, in der Schüssel marinieren und kurz ziehen lassen.",
      "timerMinutes": 10
    },
    {
      "text": "Die Nudeln kochen.",
      "timerMinutes": 8
    },
    {
      "text": "Währenddessen Öl in einer Pfanne erhitzen und die Schnitzel von beiden Seiten scharf anbraten. Dann aus der Pfanne nehmen.",
      "timerMinutes": 4
    },
    {
      "text": "Die Butter in der Pfanne schmelzen und das Mehl darin anschwitzen.",
      "timerMinutes": 1
    },
    {
      "text": "Die restliche Marinade und Milch in die Pfanne geben und die Gemüsebrühe einrühren. Aufkochen lassen, dann die Schnitzel wieder dazugeben und 10 Minuten kochen lassen.",
      "timerMinutes": 10
    },
    {
      "text": "Die Nudeln, Schnitzel und Soße auf die Teller verteilen und Kürbiskerne darüberstreuen."
    }
  ]
}

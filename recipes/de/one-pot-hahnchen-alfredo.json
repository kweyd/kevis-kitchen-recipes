  "steps": [
    {
      "text": "Hähnchen in mundgerechte Stücke schneiden und den Knoblauch klein hacken."
    },
    {
      "text": "Einen Topf mit etwas Öl erhitzen und Knoblauch und Hähnchen scharf anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Mit Hühnerbrühe und Kochsahne ablöschen."
    },
    {
      "text": "Die Nudeln dazugeben und mit Deckel unter regelmäßigem Umrühren 15 Minuten kochen lassen.",
      "timerMinutes": 15
    },
    {
      "text": "Geriebenen Parmesan und Petersilie unterheben und mit Pfeffer, Salz und dem Saft einer halben Zitrone abschmecken."
    }
  ]

  "steps": [
    {
      "text": "Den Bulgur mit der doppelten Menge Wasser in einem Topf kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Salatgurke, Tomaten, Petersilie, Minze und Zwiebel kleinschneiden und in eine Schüssel geben."
    },
    {
      "text": "Den Zitronensaft darüber auspressen und das Olivenöl dazugeben."
    },
    {
      "text": "Den Bulgur abkühlen lassen und mit in die Schüssel geben.",
      "timerMinutes": 15
    },
    {
      "text": "Dann die Granatapfelkerne dazugeben, umrühren und mit Pfeffer, Salz und Chili abschmecken."

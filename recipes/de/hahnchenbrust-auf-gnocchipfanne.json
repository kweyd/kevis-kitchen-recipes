  "steps": [
    {
      "text": "Kochsahne, Hühnerbrühe, Pesto und 50 ml Wasser verrühren."
    },
    {
      "text": "Die Kirschtomaten waschen und halbieren."
    },
    {
      "text": "Die Hähnchenbrust aufschneiden, aufklappen und mit Salz und Pfeffer würzen."
    },
    {
      "text": "Die Hähnchenbrust für 2x 9 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 18
    },
    {
      "text": "Die Pinienkerne in einer Pfanne ohne Öl anrösten.",
      "timerMinutes": 3
    },
    {
      "text": "Die Gnocchi in einer Pfanne mit Öl anbraten und die Kirschtomaten dazugeben.",
      "timerMinutes": 6
    },
    {
      "text": "Die Soße in die Pfanne mit den Gnocchi geben. Spinat dazugeben, zusammenfallen lassen und mit Salz und Pfeffer abschmecken.",
      "timerMinutes": 3
    },
    {
      "text": "Alles auf Teller geben und mit Parmesan und den Pinienkernen servieren."
    }
  ]

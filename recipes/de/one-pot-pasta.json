  "steps": [
    {
      "text": "Öl in einen Topf geben und das Hackfleisch anbraten.",
      "timerMinutes": 5
    },
    {
      "text": "Karotte, Zwiebel, Knoblauch und Chilischote kleinschneiden, zu dem Hackfleisch geben und 3 Minuten mit anschwitzen.",
      "timerMinutes": 3
    },
    {
      "text": "Kräuter und Tomatenmark dazugeben und umrühren. Anschließend mit der Rinderbrühe ablöschen."
    },
    {
      "text": "Stückige Tomaten, Salz, Pfeffer und Zucker dazugeben und abschmecken."
    },
    {
      "text": "Die Nudeln mit 100 ml Wasser in den Topf geben und mit Deckel bei mittlerer Hitze 11–15 Minuten köcheln lassen. Immer wieder umrühren.",
      "timerMinutes": 12
    },
    {
      "text": "Mit geriebenem Parmesan servieren."
    }
  ]

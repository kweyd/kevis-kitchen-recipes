  "steps": [
    {
      "text": "Zwiebel, Knoblauch und Ingwer schälen und kleinhacken. Lauchzwiebeln und Pak Choi waschen und kleinschneiden."
    },
    {
      "text": "Sprossen waschen und Hähnchen in Streifen schneiden."
    },
    {
      "text": "Den Reis waschen und kochen.",
      "timerMinutes": 12
    },
    {
      "text": "Öl in einer Pfanne erhitzen und das Hähnchen anbraten. Mit dem Weißwein ablöschen.",
      "timerMinutes": 5
    },
    {
      "text": "Knoblauch, Zwiebel und Ingwer in die Pfanne geben und anbraten.",
      "timerMinutes": 2
    },
    {
      "text": "Pak Choi, Lauchzwiebeln und Sprossen in die Pfanne geben. Mit Pfeffer und Salz abschmecken.",
      "timerMinutes": 3
    },
    {
      "text": "Gemüsebrühe, Sojasoße, Essig und Speisestärke verrühren, in die Pfanne geben und alles aufkochen lassen.",
      "timerMinutes": 2
    },
    {
      "text": "Mit Erdnüssen und Reis servieren."
    }
  ]

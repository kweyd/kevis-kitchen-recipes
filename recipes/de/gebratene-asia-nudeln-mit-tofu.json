  "steps": [
    {
      "text": "Die Nudeln in einer Schüssel mit kochendem Wasser ziehen lassen.",
      "timerMinutes": 5
    },
    {
      "text": "Den Tofu auf einem Küchenpapier ausdrücken, in kleine Stücke schneiden und mit Speisestärke bestreuen."
    },
    {
      "text": "Den Tofu für 2x 5 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 10
    },
    {
      "text": "Karotten, Knoblauch und Chilis kleinschneiden und in eine Schüssel geben."
    },
    {
      "text": "Sesam, Agavendicksaft, Erdnussöl, Sojasoße und Reisessig dazugeben. Alles miteinander vermischen und in einer Pfanne aufkochen.",
      "timerMinutes": 5
    },
    {
      "text": "Die Nudeln abgießen und in einer anderen Pfanne kurz anbraten. Dann die Soße und den Tofu dazugeben und alles vermischen."
    },
    {
      "text": "Die Lauchzwiebeln in Ringe schneiden und über die Portionen verteilen."
    }
  ]

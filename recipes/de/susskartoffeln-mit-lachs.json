  "steps": [
    {
      "text": "Die Süßkartoffel gründlich waschen, einschneiden und für 25 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 25
    },
    {
      "text": "Die Süßkartoffel wenden und weitere 25 Minuten garen.",
      "timerMinutes": 25
    },
    {
      "text": "Reis in einem Topf kochen.",
      "timerMinutes": 15
    },
    {
      "text": "Petersilie klein schneiden. Radieschen und Gurke würfeln und mit einem Teil der Petersilie und dem Rucola in eine Schüssel geben. Kirschtomaten halbieren und dazugeben."
    },
    {
      "text": "Mit etwas Essig, Öl, Pfeffer und Salz ein Dressing machen und darübergeben. Den fertigen Reis dazugeben."
    },
    {
      "text": "Für den Dip die Knoblauchzehen in den Joghurt pressen. Etwas Pfeffer, Salz, Honig und die restliche Petersilie dazugeben."
    },
    {
      "text": "Den Lachs mit Pfeffer und Salz würzen, mit Zitronenscheiben belegen und für 20 Minuten bei 160 °C in den Airfryer geben.",
      "timerMinutes": 20
    },
    {
      "text": "Den Lachs zerpflücken und mit dem Salat vermischen."
    },
    {
      "text": "Die Süßkartoffel aufschneiden und mit einem Löffel etwas aushöhlen. Etwas von dem Salat in die Süßkartoffel geben und mit dem Dip servieren."
    }
  ]
}

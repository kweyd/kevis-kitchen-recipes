  "steps": [
    {
      "text": "Für das Tzatziki in einer Schüssel den Joghurt mit Petersilie, je ½ TL Salz und Pfeffer, dem Saft einer halben Zitrone und dem Weißweinessig vermischen. 3 Knoblauchzehen dazupressen."
    },
    {
      "text": "100 g Gurke schälen, entkernen und raspeln, mit einem Geschirrtuch ausdrücken und in die Schüssel geben. Zum Schluss ½ EL Olivenöl darüberträufeln."
    },
    {
      "text": "Für das Gyros Chili, die restliche Gurke und die Kirschtomaten klein schneiden. Das Hähnchen klein schneiden, falls man kein Geschnetzeltes hat."
    },
    {
      "text": "Das Hähnchen mit 2 EL Olivenöl, Oregano, Thymian, dem Saft einer Zitrone, Paprikapulver, je ½ TL Pfeffer und Salz und dem Honig in eine Schüssel geben und die restlichen 3 Knoblauchzehen dazupressen. Alles vermischen und 30 Minuten ziehen lassen.",
      "timerMinutes": 30
    },
    {
      "text": "Die Kritharaki in einem Topf mit kochendem Wasser 10 Minuten kochen.",
      "timerMinutes": 10
    },
    {
      "text": "Gleichzeitig das Hähnchen in einer Pfanne braten.",
      "timerMinutes": 8
    },
    {
      "text": "Das Hähnchen mit Tzatziki, Tomaten, Gurke, den Kritharaki und Zitronenspalten servieren."
    }
  ]

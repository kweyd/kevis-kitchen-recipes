  "steps": [
    {
      "text": "Knoblauch schälen und klein hacken."
    },
    {
      "text": "Champignons vierteln. Sellerie und Karotten schälen und klein schneiden. Porree in Ringe und die Hähnchenbrustfilets klein schneiden."
    },
    {
      "text": "Zuerst den Knoblauch in etwas Öl andünsten und dann das Tomatenmark dazugeben.",
      "timerMinutes": 2
    },
    {
      "text": "Mit der Brühe ablöschen und aufkochen lassen."
    },
    {
      "text": "Hähnchenflügel, Kräuter der Provence, Paprikapulver, Porree, Champignons, Karotten, Knollensellerie und die Hähnchenbrustfilets dazugeben und insgesamt 25 Minuten kochen lassen.",
      "timerMinutes": 15
    },
    {
      "text": "Die letzten 10 Minuten die Buchstabennudeln dazugeben.",
      "timerMinutes": 10
    },
    {
      "text": "Lauchzwiebel in Ringe schneiden. Die Suppe mit Pfeffer und Salz abschmecken und mit Lauchzwiebeln servieren."
    }
  ]

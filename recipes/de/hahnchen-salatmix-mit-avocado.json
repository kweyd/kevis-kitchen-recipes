  "steps": [
    {
      "text": "Hähnchenbrust in Streifen schneiden und für 2x 10 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 10
    },
    {
      "text": "Salat waschen und kräftig schleudern."
    },
    {
      "text": "Die Zwiebel schälen und in Ringe schneiden. Gurke und Tomaten in Stücke schneiden."
    },
    {
      "text": "Mais abtropfen lassen, Karotte schälen und hobeln und alles mit dem Salat in eine Schüssel geben."
    },
    {
      "text": "Für das Dressing Schale und Kern der Avocado entfernen und den Knoblauch schälen. Alles mit dem Saft einer Zitrone, der Chili, 2 EL Olivenöl und etwas Pfeffer und Salz pürieren."
    },
    {
      "text": "Dressing mit dem Hähnchen in die Schüssel geben und umrühren."
    }

  "steps": [
    {
      "text": "Die Zucchini waschen und längs halbieren. Mit einem Löffel innen aushöhlen."
    },
    {
      "text": "Das Fleisch in kleine Stücke schneiden und mit Pfeffer, Salz, etwas Öl, Chilipulver und Paprika edelsüß marinieren."
    },
    {
      "text": "Das Hähnchen für 2x 8 Minuten bei 200 °C in den Airfryer geben.",
      "timerMinutes": 8
    },
    {
      "text": "Währenddessen die Kokosmilch mit den Erbsen und dem Mandelmus in einem Topf erwärmen. Wenn das Fleisch fertig ist, kurz im Topf mit der Masse verrühren."
    },
    {
      "text": "Die ausgehöhlten Zucchini in den Airfryer legen, mit der Masse aus dem Topf füllen und für 14 Minuten bei 180 °C garen.",
      "timerMinutes": 14
    },
    {
      "text": "Mit Schnittlauch und Parmesan garnieren."
    }
  ]
}

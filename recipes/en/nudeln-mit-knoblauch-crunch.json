  "steps": [
    {
      "text": "Melt the butter in a pan. Peel the garlic and grate it into the pan."
    },
    {
      "text": "Add the breadcrumbs and sesame seeds and toast everything until golden brown. Then set aside.",
      "timerMinutes": 4
    },
    {
      "text": "Cook the pasta.",
      "timerMinutes": 10
    },
    {
      "text": "Peel and finely chop the onion. Heat the olive oil in a large pan and fry the onion.",
      "timerMinutes": 3
    },
    {
      "text": "Add the tomato paste and let it toast a little. Add the passata and cream and season with salt and pepper.",
      "timerMinutes": 2
    },
    {
      "text": "Add a splash of pasta water to the pan and drain the pasta. Then add the pasta to the pan, grate the parmesan over it and add the chopped parsley. Stir everything and leave it in the pan briefly."
    },
    {
      "text": "Serve and sprinkle the cooled garlic crunch over the portions."
    }
  ]

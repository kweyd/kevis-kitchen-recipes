  "steps": [
    {
      "text": "Finely chop the onion, garlic, peppers and chilli."
    },
    {
      "text": "Heat the oil in a pan and fry the onion until translucent.",
      "timerMinutes": 3
    },
    {
      "text": "Add the mince and fry until crumbly.",
      "timerMinutes": 5
    },
    {
      "text": "Add the peppers, half of the garlic and the chilli and fry.",
      "timerMinutes": 3
    },
    {
      "text": "Add the tomato paste, paprika, pepper and salt. After two minutes, pour in 75 ml water and bring to the boil.",
      "timerMinutes": 2
    },
    {
      "text": "Stir in the chickpeas and the chopped feta."
    },
    {
      "text": "For the dip, stir the yoghurt with the remaining garlic, honey and chives and season with pepper and salt."
    }
  ]

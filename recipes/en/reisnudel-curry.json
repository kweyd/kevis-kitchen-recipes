  "steps": [
    {
      "text": "Cut the bell pepper, onion, chili, garlic, tofu, cauliflower and pak choi into bite-sized pieces."
    },
    {
      "text": "Fry everything in a pot with a little oil.",
      "timerMinutes": 5
    },
    {
      "text": "Add the curry paste and toast it briefly.",
      "timerMinutes": 1
    },
    {
      "text": "Add the coconut milk, chickpeas and vegetable stock and bring to the boil. Season with pepper and salt.",
      "timerMinutes": 5
    },
    {
      "text": "Meanwhile cook the rice noodles. Rinse them under cold water and add them to the pot.",
      "timerMinutes": 5
    },
    {
      "text": "Sprinkle the peanuts over each portion."
    }
  ]

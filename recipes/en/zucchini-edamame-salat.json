  "steps": [
    {
      "text": "Wash the courgette, halve it and slice. Peel and finely chop the garlic."
    },
    {
      "text": "Wash the lettuce and mushrooms and slice the mushrooms."
    },
    {
      "text": "Heat 2 tbsp olive oil in a pan and add the garlic, courgette and mushrooms. Add the soy sauce and let it fry for a while.",
      "timerMinutes": 6
    },
    {
      "text": "Put the lettuce in a bowl with the edamame and pistachios."
    },
    {
      "text": "For the dressing, mix the orange juice with 1 tbsp olive oil, the balsamic vinegar, honey, pepper and salt. Pour it into the bowl and toss everything."
    },
    {
      "text": "Divide the salad between plates and top with the contents of the pan."
    }
  ]

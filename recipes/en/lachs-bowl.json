  "steps": [
    {
      "text": "Put the salmon in a bowl and marinate it with the soy sauce, brown sugar, honey and finely chopped ginger and garlic."
    },
    {
      "text": "Let the salmon marinate in the fridge for 30 minutes.",
      "timerMinutes": 30
    },
    {
      "text": "Cut the avocado, orange, onion and cucumber into bite-sized pieces."
    },
    {
      "text": "Warm the edamame in hot water for 5 minutes.",
      "timerMinutes": 5
    },
    {
      "text": "Rinse and cook the rice.",
      "timerMinutes": 15
    },
    {
      "text": "Air-fry the salmon with its marinade at 180 °C for 14 minutes.",
      "timerMinutes": 14
    },
    {
      "text": "For the sauce, mix the mayonnaise with the sweet chili sauce."
    },
    {
      "text": "Finally, divide the rice between bowls and top with the salmon, toppings and sauce."
    }
  ]

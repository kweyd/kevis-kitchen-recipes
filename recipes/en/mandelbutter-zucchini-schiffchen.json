  "steps": [
    {
      "text": "Wash the courgettes and halve them lengthways. Hollow them out with a spoon."
    },
    {
      "text": "Cut the chicken into small pieces and marinate with pepper, salt, a little oil, chilli powder and sweet paprika."
    },
    {
      "text": "Air-fry the chicken at 200 °C for 2 x 8 minutes.",
      "timerMinutes": 8
    },
    {
      "text": "Meanwhile, warm the coconut milk with the peas and almond butter in a pot. When the chicken is done, stir it briefly into the mixture."
    },
    {
      "text": "Place the hollowed-out courgettes in the air fryer, fill them with the mixture from the pot and cook at 180 °C for 14 minutes.",
      "timerMinutes": 14
    },
    {
      "text": "Garnish with chives and parmesan."
    }
  ]

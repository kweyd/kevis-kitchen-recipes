  "steps": [
    {
      "text": "Make the fries in the air fryer: spray them lightly with oil and cook at 200 °C for 2 × 10 minutes.",
      "timerMinutes": 20
    },
    {
      "text": "Finely chop the onion and fry it in a pan with oil until lightly browned.",
      "timerMinutes": 4
    },
    {
      "text": "Then add the honey and caramelise the onion. Deglaze everything with the passata.",
      "timerMinutes": 2
    },
    {
      "text": "Add the remaining sauce ingredients and let it simmer over medium heat.",
      "timerMinutes": 10
    },
    {
      "text": "At the same time, fry the sausages in another pan.",
      "timerMinutes": 10
    },
    {
      "text": "Slice the sausages, divide them between the plates and pour the curry sauce over them."
    },
    {
      "text": "Divide the fries between both plates and sprinkle some chives over the sauce for colour."
    }
  ]

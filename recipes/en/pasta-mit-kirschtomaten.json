  "steps": [
    {
      "text": "Cook the pasta.",
      "timerMinutes": 9
    },
    {
      "text": "Peel and finely chop the shallot and garlic."
    },
    {
      "text": "Heat olive oil in a pan and fry the shallot. Then add the garlic, diced ham and cherry tomatoes and fry until the tomatoes burst and release their juices.",
      "timerMinutes": 8
    },
    {
      "text": "Then add the tomato paste, apple cider vinegar and white wine and let the alcohol cook off.",
      "timerMinutes": 3
    },
    {
      "text": "Toast the pine nuts in another pan.",
      "timerMinutes": 3
    },
    {
      "text": "Cut the bread into small cubes, drizzle with olive oil and toast them until golden in the pan you used for the pine nuts.",
      "timerMinutes": 4
    },
    {
      "text": "Add the lemon zest, parsley, basil and most of the parmesan to the sauce. Season with pepper and salt – if it's too acidic, add a little sugar."
    },
    {
      "text": "Arrange everything on plates and finish with a little more parmesan and basil."
    }
  ]

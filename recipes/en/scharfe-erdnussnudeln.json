  "steps": [
    {
      "text": "Chop the pak choi, carrots, spring onions and garlic. Press the tofu and cut it into small pieces too."
    },
    {
      "text": "Pour hot water over the noodles in a bowl, let them soak for 5 minutes, then drain.",
      "timerMinutes": 5
    },
    {
      "text": "Heat oil in a pan and fry the carrots. Then add the tofu and fry it too.",
      "timerMinutes": 5
    },
    {
      "text": "Once the tofu is lightly browned, add the pak choi, garlic and spring onions to the pan.",
      "timerMinutes": 3
    },
    {
      "text": "For the sauce, stir together the peanut butter, miso paste, honey, lemon juice, chili powder, soy sauce, sesame oil and water."
    },
    {
      "text": "Add the noodles to the pan and toss them with the sauce."
    }
  ]

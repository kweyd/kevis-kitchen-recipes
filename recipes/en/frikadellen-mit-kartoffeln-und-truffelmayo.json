  "steps": [
    {
      "text": "Parboil the potatoes for 15 minutes.",
      "timerMinutes": 15
    },
    {
      "text": "Then put them in the air fryer with a little salt, pepper, the diced ham and rosemary for 17 minutes at 180 °C.",
      "timerMinutes": 17
    },
    {
      "text": "For the truffle mayo, stir the mayonnaise with a little salt, the white wine vinegar and truffle oil."
    },
    {
      "text": "Peel the shallot and garlic and chop finely."
    },
    {
      "text": "Mix the mince with the remaining ingredients (shallot, garlic, egg, breadcrumbs, mustard, honey, parsley, paprika, stock powder, garlic powder, salt and pepper) and shape into patties."
    },
    {
      "text": "Fry the patties in a pan with a little oil over medium heat with a lid on, turning once.",
      "timerMinutes": 12
    },
    {
      "text": "Serve the patties with the potatoes and truffle mayo."
    }
  ]

  "steps": [
    {
      "text": "Cut the chicken breast into strips and air-fry at 200 °C for 2 x 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Wash the salad and spin it thoroughly dry."
    },
    {
      "text": "Peel the onion and cut it into rings. Cut the cucumber and tomatoes into pieces."
    },
    {
      "text": "Drain the sweetcorn, peel and slice the carrot thinly, and put everything into a bowl with the salad."
    },
    {
      "text": "For the dressing, remove the skin and stone from the avocado and peel the garlic. Blend everything with the juice of one lemon, the chilli, 2 tbsp olive oil and a little pepper and salt."
    },
    {
      "text": "Add the dressing and the chicken to the bowl and toss well."
    }
  ]

  "steps": [
    {
      "text": "For the burger sauce, blend the avocado with the juice of one lemon, 3 garlic cloves, the chili, 1 tbsp olive oil and a little pepper and salt, then let it rest in the fridge."
    },
    {
      "text": "Wash the potatoes and cut them into wedges. Toss them well in a large bowl with oil, paprika, chili powder, pepper and salt and let them marinate."
    },
    {
      "text": "Bake the wedges in the oven at 200 °C for 30 minutes, turning them occasionally.",
      "timerMinutes": 30
    },
    {
      "text": "For the sour cream, stir the crème fraîche with the juice of half a lemon, the white balsamic, one pressed garlic clove, the finely sliced spring onion, and pepper and salt."
    },
    {
      "text": "Cut the halloumi into 4 equal pieces and cook them in the air fryer at 200 °C for 12 minutes per side.",
      "timerMinutes": 12
    },
    {
      "text": "Meanwhile, butter the burger buns and toast them in a pan. Fry the 4 eggs sunny side up in another pan.",
      "timerMinutes": 4
    },
    {
      "text": "Spread a generous amount of burger sauce on the bottom bun and top with rocket. Add the halloumi, then the egg and the bun lid."
    },
    {
      "text": "For each virgin mojito, quarter a lime. Squeeze 2 quarters into the glass and add the other 2 quarters whole. Add 1 tsp brown sugar and 2 sprigs of mint and press lightly."
    },
    {
      "text": "Pour in 200 ml ginger ale and 100 ml sparkling water and fill the rest of the glass with ice."
    }
  ]

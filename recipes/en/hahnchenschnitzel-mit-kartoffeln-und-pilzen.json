  "steps": [
    {
      "text": "Wash the potatoes and boil them in a pot.",
      "timerMinutes": 25
    },
    {
      "text": "Slice the mushrooms and onion and fry them in a pan with a little oil.",
      "timerMinutes": 5
    },
    {
      "text": "Season the chicken escalope with pepper and salt on both sides."
    },
    {
      "text": "Set out three deep plates: whisk the egg in one, spread the flour in the second and the breadcrumbs in the third."
    },
    {
      "text": "Bread the schnitzel in this order, twice."
    },
    {
      "text": "Add the cooking cream to the pan and season with pepper and salt."
    },
    {
      "text": "Air-fry the schnitzel at 200 °C for 2× 8 minutes, turning it halfway.",
      "timerMinutes": 16
    },
    {
      "text": "Drain the potatoes and put them on the plate. Spoon the mushrooms over them and garnish with parsley. Squeeze the half lemon over the schnitzel as you like."
    }
  ]

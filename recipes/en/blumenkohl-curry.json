  "steps": [
    {
      "text": "Peel and dice the sweet potatoes."
    },
    {
      "text": "Lightly fry the curry paste in a pan and deglaze with the coconut milk.",
      "timerMinutes": 1
    },
    {
      "text": "Add the sweet potatoes to the pan and cook with a lid on for 5 minutes.",
      "timerMinutes": 5
    },
    {
      "text": "Wash the cauliflower and cut it into bite-sized florets."
    },
    {
      "text": "Add the cauliflower and stock to the pan and simmer uncovered for 15 minutes.",
      "timerMinutes": 15
    },
    {
      "text": "Drain and rinse the chickpeas. Add them to the pan and cook for another 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Season with paprika, nutmeg, curry powder, marjoram and salt."
    },
    {
      "text": "Chop the parsley, mix it with the yoghurt and serve with the curry."
    }
  ]

  "steps": [
    {
      "text": "Peel the garlic and chop finely."
    },
    {
      "text": "Quarter the mushrooms. Peel the celeriac and carrots and cut into small pieces. Slice the leek into rings and cut the chicken breast into small pieces."
    },
    {
      "text": "First sauté the garlic in a little oil, then add the tomato paste.",
      "timerMinutes": 2
    },
    {
      "text": "Deglaze with the stock and bring to the boil."
    },
    {
      "text": "Add the chicken wings, herbes de Provence, paprika, leek, mushrooms, carrots, celeriac and chicken breast and let it cook for 25 minutes in total.",
      "timerMinutes": 15
    },
    {
      "text": "Add the alphabet pasta for the last 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Slice the spring onion. Season the soup with pepper and salt and serve topped with spring onion."
    }
  ]

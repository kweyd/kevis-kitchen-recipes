  "steps": [
    {
      "text": "Cook the rice according to the package instructions.",
      "timerMinutes": 15
    },
    {
      "text": "Wash the broccoli, cut it into small pieces and cook in salted water for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Season the salmon with salt and pepper. Place 2 lemon slices on each piece and cook in the air fryer at 160 °C for 20 minutes.",
      "timerMinutes": 20
    },
    {
      "text": "Put the curry paste in a pan and toast it.",
      "timerMinutes": 1
    },
    {
      "text": "Deglaze with the coconut milk and let it simmer briefly.",
      "timerMinutes": 3
    },
    {
      "text": "Drain the broccoli, add the cream, nutmeg, pepper and salt and purée everything."
    },
    {
      "text": "Serve everything together with the lemon slices."

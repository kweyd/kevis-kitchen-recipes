  "steps": [
    {
      "text": "Peel the red onions and garlic and chop them finely."
    },
    {
      "text": "Then fry them in oil. Add half a teaspoon of honey to lightly caramelise the onions.",
      "timerMinutes": 5
    },
    {
      "text": "Halve the cherry tomatoes and add them to the pan with the spinach. Wait until the spinach has wilted.",
      "timerMinutes": 2
    },
    {
      "text": "Mix 50 ml water with half a teaspoon of vegetable stock and add it to the pan together with the gnocchi."
    },
    {
      "text": "Season with pepper and salt to taste and let it cook for 5 minutes.",
      "timerMinutes": 5
    },
    {
      "text": "Finish with some parmesan and basil and serve."
    }
  ]

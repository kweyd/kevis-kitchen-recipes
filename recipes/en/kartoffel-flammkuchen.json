  "steps": [
    {
      "text": "Preheat the oven to 220 °C. Peel the potatoes and cut them into very thin slices."
    },
    {
      "text": "Finely chop the rosemary."
    },
    {
      "text": "Knead the flour thoroughly with 100 ml water, the olive oil and a little salt."
    },
    {
      "text": "Roll out the dough and place it on a baking tray lined with baking paper."
    },
    {
      "text": "Spread the cream cheese mixed with Italian herbs over the dough."
    },
    {
      "text": "Arrange the potato slices on top, slightly overlapping. Sprinkle with rosemary and parmesan and season with pepper."
    },
    {
      "text": "Bake in the oven at 220 °C for 14 minutes.",
      "timerMinutes": 14
    }
  ]

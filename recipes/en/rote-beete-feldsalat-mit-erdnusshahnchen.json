  "steps": [
    {
      "text": "Wash the lamb's lettuce and divide it between 2 plates. Slice the beetroot and divide it between the plates as well."
    },
    {
      "text": "Make a dressing from the white wine vinegar, olive oil, pepper, salt, honey, freshly squeezed orange juice and water and drizzle it over the plates."
    },
    {
      "text": "Heat oil in a pan, cut the chicken into small cubes and sear them over high heat.",
      "timerMinutes": 6
    },
    {
      "text": "Meanwhile, heat the lentils in a pot.",
      "timerMinutes": 3
    },
    {
      "text": "Deglaze the chicken with soy sauce, then add the peanut butter and stir until everything is evenly coated. Now add the sesame seeds and keep stirring."
    },
    {
      "text": "Divide the lentils between the plates and top with the chicken."
    }
  ]

  "steps": [
    {
      "text": "Finely chop the onion, garlic and chili. Cut the bell peppers into strips."
    },
    {
      "text": "Fry the onion in a pan with a little oil, add the mince and fry until crumbly.",
      "timerMinutes": 6
    },
    {
      "text": "Add 2 garlic cloves, the chili and bell peppers to the mince. Then stir in the tomato paste and season with paprika, salt and pepper.",
      "timerMinutes": 4
    },
    {
      "text": "Add 75 ml water and let it simmer for a few minutes.",
      "timerMinutes": 3
    },
    {
      "text": "Fold in the chickpeas and the diced feta and let them warm through."
    },
    {
      "text": "Mix the schmand with the juice of the half lemon, 3 garlic cloves, honey, parsley, pepper and salt and serve with the skillet."
    }
  ]

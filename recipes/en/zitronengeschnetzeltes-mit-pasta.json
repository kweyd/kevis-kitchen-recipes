  "steps": [
    {
      "text": "Cook the pasta in a pot according to the package instructions.",
      "timerMinutes": 9
    },
    {
      "text": "Cut the pork escalopes into strips and marinate them in a bowl with 4 of the garlic cloves, the zest of the lemon, 25 ml white wine, a little oil, pepper and salt."
    },
    {
      "text": "Peel and finely chop the onion and fry it in a pan with the last garlic clove.",
      "timerMinutes": 3
    },
    {
      "text": "Add the pork with its marinade and let it brown.",
      "timerMinutes": 5
    },
    {
      "text": "Deglaze with the remaining white wine and let it reduce completely.",
      "timerMinutes": 3
    },
    {
      "text": "Add the sour cream, chili powder and the juice of half the lemon and bring to the boil."
    },
    {
      "text": "Drain the pasta, add it to the pan together with the basil and stir."
    }
  ]

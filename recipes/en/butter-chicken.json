  "steps": [
    {
      "text": "Cut the chicken into bite-sized pieces and marinate in a bowl with the curry paste and yoghurt."
    },
    {
      "text": "Peel and finely chop the onion."
    },
    {
      "text": "Melt the butter in a pan and press the garlic into it. Add the onion and fry.",
      "timerMinutes": 4
    },
    {
      "text": "Add the allspice, cinnamon and cardamom to the pan."
    },
    {
      "text": "Cook the rice in a pot.",
      "timerMinutes": 15
    },
    {
      "text": "Air-fry the chicken with its marinade at 200 °C for 2 x 8 minutes.",
      "timerMinutes": 16
    },
    {
      "text": "Add the tomato paste to the pan and toast lightly. Add 50 ml water and the cooking cream.",
      "timerMinutes": 2
    },
    {
      "text": "Season with pepper and salt and stir the chicken and its marinade into the sauce."
    }
  ]

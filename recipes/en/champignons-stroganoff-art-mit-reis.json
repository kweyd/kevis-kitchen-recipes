  "steps": [
    {
      "text": "Peel and grate the carrot."
    },
    {
      "text": "Heat the butter in a pot and toast the rice with the grated carrot. Add 300 ml boiling water, cover and simmer over medium heat.",
      "timerMinutes": 15
    },
    {
      "text": "Peel the onion and garlic. Finely chop the garlic and slice the onion into rings. Cut the mushrooms into thin strips."
    },
    {
      "text": "Heat oil in a pan and fry the onion. Then add the garlic and mushrooms.",
      "timerMinutes": 6
    },
    {
      "text": "Add the paprika, soy sauce, cooking cream and vegetable stock to the pan."
    },
    {
      "text": "Mix the cornflour with a little water and stir it into the pan."
    },
    {
      "text": "Towards the end, add the spinach and parsley and season with pepper and salt."
    },
    {
      "text": "Serve everything on plates."
    }
  ]

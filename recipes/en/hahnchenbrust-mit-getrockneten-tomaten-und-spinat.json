  "steps": [
    {
      "text": "Rinse and cook the rice.",
      "timerMinutes": 12
    },
    {
      "text": "Peel and finely chop the onion and garlic."
    },
    {
      "text": "Cut the chicken into bite-sized pieces, marinate with a little oil, pepper and salt and air-fry at 200 °C for 2 x 8 minutes.",
      "timerMinutes": 8
    },
    {
      "text": "Heat a little oil in a pan. Lightly fry the onion and garlic, then add the washed spinach and the drained sun-dried tomatoes.",
      "timerMinutes": 3
    },
    {
      "text": "After a few minutes, deglaze with the stock. Add the cream and the chicken to the pan."
    },
    {
      "text": "Season with oregano, basil, pepper and salt. Grate the parmesan into the pan."
    },
    {
      "text": "Divide the rice between the plates and spoon the contents of the pan over it."
    }
  ]

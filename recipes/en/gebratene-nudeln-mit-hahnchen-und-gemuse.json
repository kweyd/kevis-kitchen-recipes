  "steps": [
    {
      "text": "Cut the chicken into thin strips."
    },
    {
      "text": "Marinate the chicken in a bowl with 2 tbsp soy sauce, garlic powder, ginger, sesame oil and honey and leave for 30 minutes.",
      "timerMinutes": 30
    },
    {
      "text": "Cook the chicken in the air fryer at 200 °C for 2× 9 minutes.",
      "timerMinutes": 18
    },
    {
      "text": "Chop the spring onion, red and white onion and mushrooms. Cut the broccoli, carrots and pepper into bite-sized pieces."
    },
    {
      "text": "Pour boiling water over the noodles and let them soak for 5 minutes.",
      "timerMinutes": 5
    },
    {
      "text": "Stir-fry the vegetables in a pan with a little oil. Season with chili powder, pepper, salt and 0.5 tbsp soy sauce.",
      "timerMinutes": 8
    },
    {
      "text": "Toss the noodles with 0.5 tbsp soy sauce and briefly fry them in the pan.",
      "timerMinutes": 2
    },
    {
      "text": "Serve on plates with the chicken and sprinkle with spring onion and a few sesame seeds."
    }
  ]

  "steps": [
    {
      "text": "Peel and finely chop the shallots."
    },
    {
      "text": "Heat olive oil in a pot and fry the shallots.",
      "timerMinutes": 2
    },
    {
      "text": "Add the risotto rice to the pot and deglaze with the white wine."
    },
    {
      "text": "Prepare the vegetable stock and blend 100 ml of it with 50 g of the peas."
    },
    {
      "text": "Gradually pour the remaining stock over the rice, adding the stock with the puréed peas as well.",
      "timerMinutes": 15
    },
    {
      "text": "For the last 5 minutes, add the remaining peas and season with pepper and salt.",
      "timerMinutes": 5
    },
    {
      "text": "To serve, sprinkle 2 tablespoons of grated cheese on top."
    }

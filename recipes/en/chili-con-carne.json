  "steps": [
    {
      "text": "Peel and finely chop the onion and garlic. Chop the bell pepper and chili."
    },
    {
      "text": "Heat oil in a pot and brown the mince over high heat. Deglaze with a splash of beef stock every now and then until half of the stock is used up – let it evaporate each time.",
      "timerMinutes": 8
    },
    {
      "text": "Then add the onion and garlic. Once the onion is translucent, add the paprika powder and tomato paste and fry briefly.",
      "timerMinutes": 3
    },
    {
      "text": "Now add the remaining spices, the bell pepper, chili, passata, chopped tomatoes and the rest of the stock and let everything cook for 30 minutes.",
      "timerMinutes": 30
    },
    {
      "text": "Then add the corn, kidney beans and chocolate to the pot and simmer for another 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Season with pepper and salt and serve each portion with a tablespoon of crème fraîche."
    }
  ]

  "steps": [
    {
      "text": "Wash the peppers, cut off the tops and hollow them out."
    },
    {
      "text": "Cook the rice.",
      "timerMinutes": 12
    },
    {
      "text": "Meanwhile, peel and finely chop the onion and garlic. Finely chop the chilli."
    },
    {
      "text": "Mix everything with the cooked rice, the mince, the eggs and the parsley and season with salt and pepper."
    },
    {
      "text": "Preheat the oven to 160 °C."
    },
    {
      "text": "Fill the peppers with the mince mixture and put the tops back on. Stand the peppers upright in a baking dish and put them in the oven.",
      "timerMinutes": 15
    },
    {
      "text": "Mix the passata with the stock and tomato paste and pour it into the dish for the last 15 minutes. Sprinkle the cheese over the top.",

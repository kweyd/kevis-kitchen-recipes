  "steps": [
    {
      "text": "Cut the chicken into small pieces and season with pepper, salt, garlic, cardamom, thyme and half of the paprika."
    },
    {
      "text": "Air-fry the chicken at 200 °C for 8 minutes.",
      "timerMinutes": 8
    },
    {
      "text": "Air-fry the vegetables at 150 °C for 14 minutes.",
      "timerMinutes": 14
    },
    {
      "text": "Season the cream cheese with pepper, salt, the remaining paprika, curry powder and miso paste. Add a little water and stir until creamy."
    },
    {
      "text": "Turn the chicken, pour the cream cheese sauce over it and air-fry at 200 °C for another 8 minutes.",
      "timerMinutes": 8
    },
    {
      "text": "Serve the chicken with the vegetables."
    }
  ]

  "steps": [
    {
      "text": "Put the flour, salt, oil and egg yolk in a bowl and gradually add 250 ml water while kneading."
    },
    {
      "text": "Let the dough rest in the fridge for at least 2 hours.",
      "timerMinutes": 120
    },
    {
      "text": "For the filling, finely dice the onion, garlic and chilies. Wash the parsley, shake it dry and chop finely."
    },
    {
      "text": "Mix everything with the mince. Season with salt, pepper and cayenne."
    },
    {
      "text": "Add a pinch of beef stock powder and mix with about 2 cups of water in a bowl. Also leave to rest in the fridge for at least 2 hours.",
      "timerMinutes": 120
    },
    {
      "text": "Roll the dough out thinly on a floured surface and cut out circles about 10–15 cm in diameter."
    },
    {
      "text": "Place 1 tbsp of filling in the centre of each circle. Fold the dough up, making small pleats, and twist it tightly closed at the top."
    },
    {
      "text": "Cook the dumplings in boiling salted water over medium heat for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Lift them out one by one and rinse with ice-cold water."
    }
  ]
}

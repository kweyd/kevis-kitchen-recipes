  "steps": [
    {
      "text": "Cook the pasta in a pot.",
      "timerMinutes": 8
    },
    {
      "text": "Cut the chicken breast into pieces and marinate in a bowl with olive oil, a third of the parmesan, paprika, pepper and salt."
    },
    {
      "text": "Sear the chicken on all sides in a pan, then take it out.",
      "timerMinutes": 6
    },
    {
      "text": "Finely chop the garlic and fry it with a little oil in the same pan.",
      "timerMinutes": 1
    },
    {
      "text": "Deglaze with the cooking cream and add the parsley, basil, herb cream cheese and the rest of the parmesan."
    },
    {
      "text": "Season with salt and pepper, drain the pasta and add it to the pan."
    },
    {
      "text": "Serve together with the chicken."
    }
  ]

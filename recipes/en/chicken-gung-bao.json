  "steps": [
    {
      "text": "Peel and finely chop the onion, garlic and ginger. Wash and chop the spring onions and pak choi."
    },
    {
      "text": "Rinse the sprouts and cut the chicken into strips."
    },
    {
      "text": "Rinse and cook the rice.",
      "timerMinutes": 12
    },
    {
      "text": "Heat oil in a pan and fry the chicken. Deglaze with the white wine.",
      "timerMinutes": 5
    },
    {
      "text": "Add the garlic, onion and ginger to the pan and fry.",
      "timerMinutes": 2
    },
    {
      "text": "Add the pak choi, spring onions and sprouts. Season with pepper and salt.",
      "timerMinutes": 3
    },
    {
      "text": "Stir together the stock, soy sauce, vinegar and cornflour, pour into the pan and bring everything to the boil.",
      "timerMinutes": 2
    },
    {
      "text": "Serve with the peanuts and rice."
    }
  ]

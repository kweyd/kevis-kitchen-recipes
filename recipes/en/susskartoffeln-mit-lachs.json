  "steps": [
    {
      "text": "Wash the sweet potato thoroughly, score it and put it in the air fryer at 200 °C for 25 minutes.",
      "timerMinutes": 25
    },
    {
      "text": "Turn the sweet potato and cook for another 25 minutes.",
      "timerMinutes": 25
    },
    {
      "text": "Cook the rice in a pot.",
      "timerMinutes": 15
    },
    {
      "text": "Chop the parsley. Dice the radishes and cucumber and put them in a bowl with some of the parsley and the rocket. Halve the cherry tomatoes and add them."
    },
    {
      "text": "Make a dressing with a little vinegar, oil, pepper and salt and pour it over. Add the cooked rice."
    },
    {
      "text": "For the dip, press the garlic cloves into the yoghurt. Add a little pepper, salt, honey and the remaining parsley."
    },
    {
      "text": "Season the salmon with pepper and salt, top with lemon slices and cook in the air fryer at 160 °C for 20 minutes.",
      "timerMinutes": 20
    },
    {
      "text": "Flake the salmon and mix it into the salad."
    },
    {
      "text": "Cut open the sweet potato and hollow it out a little with a spoon. Fill it with some of the salad and serve with the dip."
    }
  ]

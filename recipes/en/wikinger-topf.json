  "steps": [
    {
      "text": "Peel the potatoes and cut them into bite-sized pieces."
    },
    {
      "text": "Boil the potatoes in a pot of salted water.",
      "timerMinutes": 20
    },
    {
      "text": "In a bowl, mix the minced beef with the finely chopped bacon, breadcrumbs, egg, finely chopped onion, minced garlic, chili powder, paprika, pepper and salt."
    },
    {
      "text": "Heat oil in a pan, shape the mince into small balls and brown them.",
      "timerMinutes": 8
    },
    {
      "text": "Add the peas and carrots and deglaze with the beef stock."
    },
    {
      "text": "After a few minutes, add the cream and bring briefly to the boil. Add a little cornflour to thicken if needed.",
      "timerMinutes": 5
    },
    {
      "text": "Season to taste with pepper, salt, paprika and parsley."
    },
    {
      "text": "Drain the potatoes and serve."
    }
  ]

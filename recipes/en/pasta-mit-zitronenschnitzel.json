  "steps": [
    {
      "text": "Put a little olive oil in a bowl. Peel the garlic and press it into the bowl. Add the zest of one lemon and the juice of 1.5 lemons along with 25 ml milk, salt and pepper."
    },
    {
      "text": "Cut the chicken breast into thin escalopes, marinate them in the bowl and leave briefly.",
      "timerMinutes": 10
    },
    {
      "text": "Cook the pasta.",
      "timerMinutes": 8
    },
    {
      "text": "Meanwhile, heat oil in a pan and sear the escalopes on both sides over high heat. Then take them out of the pan.",
      "timerMinutes": 4
    },
    {
      "text": "Melt the butter in the pan and cook the flour in it briefly.",
      "timerMinutes": 1
    },
    {
      "text": "Add the remaining marinade and milk to the pan and stir in the stock. Bring to the boil, then return the escalopes and simmer for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Divide the pasta, escalopes and sauce between the plates and sprinkle with pumpkin seeds."
    }
  ]
}

  "steps": [
    {
      "text": "Cook the rice with the vegetable stock in a pot according to the package instructions.",
      "timerMinutes": 15
    },
    {
      "text": "Cut the halloumi into small pieces and crisp them in the air fryer at 200 °C for 2× 9 minutes, turning once in between.",
      "timerMinutes": 18
    },
    {
      "text": "Wash the salad and let it drain."
    },
    {
      "text": "For the dressing, mix the juice of one lemon with the honey, mustard, olive oil, pepper and salt."
    },
    {
      "text": "Toss the salad with the dressing."
    },
    {
      "text": "Divide the rice between the plates and top with the salad. Scatter the halloumi over each portion."
    }

  "steps": [
    {
      "text": "Finely chop the shallot, grate the parmesan, and rinse and pat dry the salmon."
    },
    {
      "text": "Cook the pasta in a pot of lightly salted water.",
      "timerMinutes": 10
    },
    {
      "text": "Melt the butter in a pan and fry the shallot in it.",
      "timerMinutes": 2
    },
    {
      "text": "Season the salmon to taste, drizzle with lemon juice and air-fry at 160 °C for 16 minutes.",
      "timerMinutes": 16
    },
    {
      "text": "Add the peas, vegetable stock and crème fraîche to the pan and bring to the boil.",
      "timerMinutes": 3
    },
    {
      "text": "Drain the pasta and add it to the pan."
    },
    {
      "text": "Divide everything between the plates, add the salmon and sprinkle with parmesan."
    }
  ]

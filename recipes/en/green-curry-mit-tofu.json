  "steps": [
    {
      "text": "Cut the broccoli into small florets, slice the spring onion into thin rings and wash the snow peas."
    },
    {
      "text": "Cook the rice according to the package instructions.",
      "timerMinutes": 15
    },
    {
      "text": "Finely chop the garlic and ginger."
    },
    {
      "text": "Heat the rapeseed oil in a pot and briefly toast the garlic, ginger, curry paste and spices.",
      "timerMinutes": 1
    },
    {
      "text": "Add the broccoli, spring onion, snow peas and lemon zest and top up with the coconut milk and a little water."
    },
    {
      "text": "Simmer over medium heat for 15 minutes.",
      "timerMinutes": 15
    },
    {
      "text": "Meanwhile, cut the tofu into small pieces, marinate as you like and air-fry at 200 °C for 12 minutes.",
      "timerMinutes": 12
    },
    {
      "text": "Serve the curry with the rice and tofu."
    }
  ]

  "steps": [
    {
      "text": "Peel the carrot and chop it together with the pepper, courgette and mushrooms."
    },
    {
      "text": "Cut the chicken into small pieces, marinate with a little oil, pepper and salt and air-fry at 200 °C for 2 x 8 minutes.",
      "timerMinutes": 8
    },
    {
      "text": "Rinse and cook the rice.",
      "timerMinutes": 12
    },
    {
      "text": "Heat oil in a pan and fry the chopped vegetables. Add the cane sugar and let it caramelise for 2 minutes.",
      "timerMinutes": 2
    },
    {
      "text": "Then add the curry paste and turmeric (and the chopped chilli, if using) and fry for a few more minutes.",
      "timerMinutes": 3
    },
    {
      "text": "Deglaze with the coconut milk and the juice of one lime and simmer for five minutes.",
      "timerMinutes": 5
    },
    {
      "text": "Add the chicken and let it steep for a little while. Fold in the pak choi just before the end.",
      "timerMinutes": 3
    },
    {
      "text": "Serve with rice and garnish with the peanuts. Use the second lime if you want more lime flavour."
    }
  ]

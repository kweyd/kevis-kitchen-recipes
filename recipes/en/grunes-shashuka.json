  "steps": [
    {
      "text": "Peel and finely chop the onion and garlic."
    },
    {
      "text": "Heat oil in a pan and stir the paprika into the oil. Fry the onion and garlic in it.",
      "timerMinutes": 3
    },
    {
      "text": "Now add the frozen spinach and peas to the pan and let them thaw.",
      "timerMinutes": 5
    },
    {
      "text": "Slice the spring onions and add them to the pan with the white beans. Season with parsley, pepper and salt."
    },
    {
      "text": "Make 4 wells in the pan and crack an egg into each."
    },
    {
      "text": "Crumble the feta over the top, cover the pan with a lid and cook over medium heat for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Meanwhile, toast the ciabatta and top it with butter, garlic, salt and chives."
    }
  ]

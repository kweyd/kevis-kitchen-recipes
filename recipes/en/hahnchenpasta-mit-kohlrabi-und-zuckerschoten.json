  "steps": [
    {
      "text": "Cut the chicken breast into pieces. Peel and dice the kohlrabi. Wash the snow peas."
    },
    {
      "text": "Cook the noodles in a pot.",
      "timerMinutes": 8
    },
    {
      "text": "Marinate the chicken as you like and air-fry at 200 °C for 2× 9 minutes.",
      "timerMinutes": 18
    },
    {
      "text": "Heat the butter in a pan and sauté the kohlrabi.",
      "timerMinutes": 6
    },
    {
      "text": "Add the snow peas and deglaze with the cooking cream. Stir in the stock powder.",
      "timerMinutes": 3
    },
    {
      "text": "Add the parmesan to the sauce and season with pepper and salt."
    },
    {
      "text": "Briefly toss the noodles and chicken in the pan."
    }
  ]

  "steps": [
    {
      "text": "Cut the chicken breast into small pieces. Peel and press the garlic."
    },
    {
      "text": "Marinate the chicken with 15 ml olive oil, the garlic, chili powder, paprika and one tablespoon of sesame seeds."
    },
    {
      "text": "Cook the rice together with the butter in a pot.",
      "timerMinutes": 15
    },
    {
      "text": "Cook the marinated chicken in the air fryer at 200 °C for 18 minutes, turning halfway.",
      "timerMinutes": 18
    },
    {
      "text": "Chop the pepper, onion and mushrooms. Fry everything in a pan with a little oil.",
      "timerMinutes": 8
    },
    {
      "text": "Mix the ajvar with the mayonnaise, 5 ml olive oil and the crispy chili oil."
    },
    {
      "text": "Slice the spring onion and serve everything together, sprinkled with the remaining sesame seeds."
    }
  ]

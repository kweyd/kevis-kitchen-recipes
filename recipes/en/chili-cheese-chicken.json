  "steps": [
    {
      "text": "Cut the chicken and onion into small pieces."
    },
    {
      "text": "Spray a pan with oil and heat it. Fry the chicken and onion.",
      "timerMinutes": 8
    },
    {
      "text": "Remove the chicken from the pan."
    },
    {
      "text": "Add the cream, vegetable stock, the Old Amsterdam cut into pieces and the cream cheese spread to the pan and let it melt.",
      "timerMinutes": 4
    },
    {
      "text": "Slice the jalapeño into rings and add to the pan with the paprika and chili powder. Season with pepper and salt."
    },
    {
      "text": "Divide the lettuce leaves between the plates and top with the chicken."
    },
    {
      "text": "Finally, pour the chili cheese sauce over the top."
    }

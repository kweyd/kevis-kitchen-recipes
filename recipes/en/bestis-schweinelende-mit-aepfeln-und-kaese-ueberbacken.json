  "steps": [
    {
      "text": "Preheat the oven to 225 °C (conventional, top and bottom heat)."
    },
    {
      "text": "Trim the sinew and silver skin off the pork tenderloin, cut it into thick slices and season with salt. Sear them in a little oil over high heat."
    },
    {
      "text": "Peel, core and slice the apples. Peel the onion and slice it as well."
    },
    {
      "text": "Season the seared pork with pepper and layer it in a baking dish with the onions and apples. Add rosemary to taste."
    },
    {
      "text": "Whisk the cream with the ketchup, mustard, flour and curry powder. Pour it over the layered ingredients."
    },
    {
      "text": "Cover with the grated cheese and bake in the preheated oven for about 30 minutes.",
      "timerMinutes": 30
    }
  ]

  "steps": [
    {
      "text": "Peel the onion and garlic and chop finely. Cut the pepper into bite-sized pieces. Drain the corn, wash the basil and chop it."
    },
    {
      "text": "Heat the olive oil in a pot and fry the onion and pepper.",
      "timerMinutes": 4
    },
    {
      "text": "Add the garlic, corn, diced ham and mince and fry until the mince is crumbly.",
      "timerMinutes": 5
    },
    {
      "text": "Deglaze with the stock, cream and tomatoes and let it simmer for about 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Stir in the ajvar, herb cream cheese and Italian herbs. Season with salt, pepper and honey."
    },
    {
      "text": "Slice the baguette, drizzle with a little olive oil, sprinkle with Italian herbs and toast in the air fryer.",
      "timerMinutes": 4
    },
    {
      "text": "Ladle the soup into bowls and serve with parmesan and basil."
    }
  ]

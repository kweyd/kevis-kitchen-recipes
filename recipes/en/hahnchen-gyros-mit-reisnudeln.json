  "steps": [
    {
      "text": "For the tzatziki, mix the yoghurt in a bowl with the parsley, ½ tsp each of salt and pepper, the juice of half a lemon and the white wine vinegar. Press in 3 garlic cloves."
    },
    {
      "text": "Peel, deseed and grate 100 g of cucumber, squeeze it out in a tea towel and add it to the bowl. Finally drizzle ½ tbsp olive oil over the top."
    },
    {
      "text": "For the gyros, chop the chilli, the remaining cucumber and the cherry tomatoes. Cut the chicken into small pieces if it isn't already cut."
    },
    {
      "text": "Put the chicken in a bowl with 2 tbsp olive oil, the oregano, thyme, juice of one lemon, paprika, ½ tsp each of pepper and salt and the honey, and press in the remaining 3 garlic cloves. Mix well and leave to marinate for 30 minutes.",
      "timerMinutes": 30
    },
    {
      "text": "Cook the orzo in a pot of boiling water for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "At the same time, fry the chicken in a pan.",
      "timerMinutes": 8
    },
    {
      "text": "Serve the chicken with the tzatziki, tomatoes, cucumber, orzo and lemon wedges."
    }
  ]

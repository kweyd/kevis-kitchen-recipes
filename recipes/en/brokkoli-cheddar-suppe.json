  "steps": [
    {
      "text": "Separate the broccoli florets from the stalk and chop the stalk."
    },
    {
      "text": "Peel and chop the onion and garlic."
    },
    {
      "text": "Heat a third of the butter in a pot and fry the onion with the broccoli stalk.",
      "timerMinutes": 4
    },
    {
      "text": "Add the garlic and cook until lightly browned.",
      "timerMinutes": 2
    },
    {
      "text": "Deglaze with the vegetable stock and season with pepper and salt."
    },
    {
      "text": "Blend everything with a stick blender until smooth and let it simmer.",
      "timerMinutes": 10
    },
    {
      "text": "In another pot, fry the broccoli florets in the remaining butter.",
      "timerMinutes": 5
    },
    {
      "text": "Once the broccoli is lightly browned, add the blended soup, the cream and the cheddar and cook, stirring, until the cheddar has melted.",
      "timerMinutes": 3
    }
  ]

  "steps": [
    {
      "text": "Finely chop the onion and brown it in a pan with the butter.",
      "timerMinutes": 3
    },
    {
      "text": "Add the risotto rice and, once it turns slightly translucent, deglaze with the white wine."
    },
    {
      "text": "Let the rice simmer, topping it up with vegetable stock again and again so that it stays just covered with liquid.",
      "timerMinutes": 20
    },
    {
      "text": "In another pan, fry the shiitake mushrooms with the soy sauce.",
      "timerMinutes": 5
    },
    {
      "text": "Cut the chocolate into small pieces."
    },
    {
      "text": "When the liquid in the rice pan has cooked off, divide the risotto between the plates."
    },
    {
      "text": "Top each portion with the shiitake and chocolate."
    }
  ]

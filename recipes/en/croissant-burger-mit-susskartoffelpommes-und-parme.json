  "steps": [
    {
      "text": "Heat a pan without oil and fry the bacon until crispy. Meanwhile, chop the lettuce and tomato.",
      "timerMinutes": 5
    },
    {
      "text": "For the sauce, mix the mayonnaise with tomato paste, balsamic vinegar, honey, oregano, pepper and salt. Finely chop the gherkins and add them to the sauce."
    },
    {
      "text": "Shape the unseasoned ground beef into two oblong patties. Take the crispy bacon out of the pan and put the patties in instead."
    },
    {
      "text": "Fry the patties on both sides. For the last minute, place the cheddar on top and let it melt under a lid.",
      "timerMinutes": 6
    },
    {
      "text": "Slice the croissants open and spread both halves with the sauce. Layer lettuce, then the patty, tomato and bacon on the bottom half and close."
    },
    {
      "text": "Peel the sweet potato and cut it into 1 cm thick sticks. For crispier fries, soak them in cold water for 30 minutes before seasoning and dry them well.",
      "timerMinutes": 30
    },
    {
      "text": "Toss the sticks in a bowl with a little oil, salt and pressed garlic and air-fry them at 190 °C for 2 × 10 minutes.",
      "timerMinutes": 20
    },
    {
      "text": "For the dip, heat the butter in a pan. Add pressed garlic and take the pan off the heat before the garlic browns.",
      "timerMinutes": 2
    },
    {
      "text": "Add the white wine vinegar, stir in the parmesan and some parsley and keep stirring well. A blender or food processor works best – otherwise it takes a long time to get a smooth dip."
    },
    {
      "text": "When serving, sprinkle a few slices of spring onion over the dip."
    }
  ]
}

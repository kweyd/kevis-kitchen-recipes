  "steps": [
    {
      "text": "Cook the rice with a little salt and a teaspoon of curry powder.",
      "timerMinutes": 12
    },
    {
      "text": "Heat oil in a pan, lightly salt the chicken and briefly sear it on both sides.",
      "timerMinutes": 4
    },
    {
      "text": "Turn the heat down to medium and add the sambal oelek, soy sauce and coconut milk. Cover and simmer for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Slice the cucumber and put it in a bowl. Add pepper, salt, white wine vinegar, sugar, a third of the peanuts and the juice of half a lime and mix everything."
    },
    {
      "text": "To serve, put the rice on the plates with some cucumber salad on the side. Slice the chicken into strips and add it to the plates with the sauce."
    },
    {
      "text": "Serve with a lime quarter each and the remaining peanuts."
    }
  ]

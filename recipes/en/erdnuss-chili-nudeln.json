  "steps": [
    {
      "text": "Press the tofu with kitchen paper and cut it into small cubes. Peel and finely chop the onion."
    },
    {
      "text": "Fry the onion and tofu in a pot with a little oil.",
      "timerMinutes": 5
    },
    {
      "text": "Finely chop the garlic and ginger and add them to the pot. After a few minutes, add the hot pepper paste.",
      "timerMinutes": 3
    },
    {
      "text": "Add the vegetable stock, coconut milk, soy sauce, crispy chili oil and peanut butter to the pot. Season with salt and chili flakes."
    },
    {
      "text": "Pour boiling water over the mie noodles and let them soak for 5 minutes.",
      "timerMinutes": 5
    },
    {
      "text": "Toast the sesame seeds in a dry pan."
    },
    {
      "text": "Drain the noodles and divide them between the plates with the sauce. Garnish with spring onion and sesame."
    }
  ]

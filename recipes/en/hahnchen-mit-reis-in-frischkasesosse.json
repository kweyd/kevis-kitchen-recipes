  "steps": [
    {
      "text": "Rinse and cook the rice.",
      "timerMinutes": 12
    },
    {
      "text": "Meanwhile, chop the bell pepper. Butterfly the chicken breasts and fry them in oil for 3 minutes on each side.",
      "timerMinutes": 3
    },
    {
      "text": "Take them out of the pan and brush with mustard. Wrap the bacon around the chicken and brush thinly with honey."
    },
    {
      "text": "Cook the chicken with the bell pepper in the air fryer at 200 °C for 10 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "For the sauce, bring the herb cream cheese to the boil with the milk, cream, vegetable stock and a little pepper.",
      "timerMinutes": 3
    },
    {
      "text": "Plate everything up together."
    }
  ]

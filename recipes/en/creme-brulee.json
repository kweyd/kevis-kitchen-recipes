  "steps": [
    {
      "text": "Preheat the oven to 150 °C."
    },
    {
      "text": "Whisk the cream with the egg yolks and the milk."
    },
    {
      "text": "Then add the vanilla seeds, sugar and lemon zest and mix again."
    },
    {
      "text": "Pour the mixture into ramekins, place them in a deep baking tray filled with boiling water and bake in the preheated oven at 150 °C for 55 minutes.",
      "timerMinutes": 55
    },
    {
      "text": "Refrigerate the ramekins overnight."
    },
    {
      "text": "Just before serving, sprinkle each ramekin evenly with a tablespoon of sugar and caramelise it with a blowtorch."
    }
  ]

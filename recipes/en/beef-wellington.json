  "steps": [
    {
      "text": "Vacuum-seal the beef fillet and cook sous vide at 52 °C for 90 minutes.",
      "timerMinutes": 90
    },
    {
      "text": "Put the chestnuts, mushrooms, thyme leaves, garlic and white wine in a blender and blitz finely."
    },
    {
      "text": "Cook the mixture in a dry pan until all the liquid has evaporated.",
      "timerMinutes": 10
    },
    {
      "text": "Lay out cling film and arrange the ham on it. Spread the mushroom mixture over the ham."
    },
    {
      "text": "Season the beef with salt and pepper, sear it all over in a hot pan with a little oil and brush with mustard.",
      "timerMinutes": 3
    },
    {
      "text": "Place the fillet on the ham and mushroom layer, roll up tightly using the cling film and chill for at least 15 minutes.",
      "timerMinutes": 15
    },
    {
      "text": "Lay out fresh cling film and roll out the puff pastry on it."
    },
    {
      "text": "Unwrap the fillet, place it on the pastry, roll it up and chill again for at least 15 minutes.",
      "timerMinutes": 15
    },
    {
      "text": "Preheat the oven to 200 °C."
    },
    {
      "text": "Brush the pastry with egg yolk and bake for 22 minutes.",
      "timerMinutes": 22
    }
  ]
}

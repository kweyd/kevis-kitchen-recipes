  "steps": [
    {
      "text": "Cut the chicken, chilies, garlic and onion into small pieces. Put the chicken and chilies in a bowl."
    },
    {
      "text": "Spray with a little rapeseed oil and add the paprika, garlic and chili powder. Season with pepper and salt, sprinkle with 1 tbsp sesame seeds and let the chicken marinate in everything.",
      "timerMinutes": 10
    },
    {
      "text": "Cook the rice in a pot.",
      "timerMinutes": 15
    },
    {
      "text": "Fry the contents of the bowl together with the onion in a pan.",
      "timerMinutes": 5
    },
    {
      "text": "Cut the bell pepper and mushrooms into small pieces and add them to the pan. Spray with a little more rapeseed oil if needed and add the remaining 2 tbsp sesame seeds.",
      "timerMinutes": 6
    },
    {
      "text": "For the dip, mix the mayonnaise with the ajvar, olive oil and crispy chili oil."
    },
    {
      "text": "Serve the chicken and vegetables with rice and the dip."
    }
  ]

  "steps": [
    {
      "text": "Cut the chicken into bite-sized pieces and finely chop the garlic."
    },
    {
      "text": "Heat a little oil in a pot and sear the garlic and chicken over high heat.",
      "timerMinutes": 5
    },
    {
      "text": "Deglaze with the chicken stock and cooking cream."
    },
    {
      "text": "Add the pasta, cover and cook for 15 minutes, stirring regularly.",
      "timerMinutes": 15
    },
    {
      "text": "Fold in the grated parmesan and parsley and season with pepper, salt and the juice of half a lemon."
    }

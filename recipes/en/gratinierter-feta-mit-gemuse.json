  "steps": [
    {
      "text": "Place the feta in the middle of an ovenproof dish."
    },
    {
      "text": "Peel the garlic bulb and put the whole cloves in a bowl."
    },
    {
      "text": "Peel the onions and cut them into strips, finely chop the chili, halve the olives, dice the bell pepper, and quarter and slice the courgette."
    },
    {
      "text": "Add everything to the bowl with the cherry tomatoes and mix with the spices, parsley, honey and olive oil."
    },
    {
      "text": "Spread the vegetables over the feta in the dish."
    },
    {
      "text": "Bake at 200 °C for 25 minutes.",
      "timerMinutes": 25
    },
    {
      "text": "Serve with some baguette if you like."
    }
  ]

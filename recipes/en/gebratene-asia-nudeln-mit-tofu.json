  "steps": [
    {
      "text": "Soak the noodles in a bowl of boiling water.",
      "timerMinutes": 5
    },
    {
      "text": "Press the tofu on kitchen paper, cut it into small pieces and dust with cornstarch."
    },
    {
      "text": "Air-fry the tofu at 200 °C for 2× 5 minutes.",
      "timerMinutes": 10
    },
    {
      "text": "Finely chop the carrots, garlic and chilies and put them in a bowl."
    },
    {
      "text": "Add the sesame seeds, agave syrup, peanut oil, soy sauce and rice vinegar. Mix everything and bring to the boil in a pan.",
      "timerMinutes": 5
    },
    {
      "text": "Drain the noodles and briefly fry them in another pan. Then add the sauce and tofu and toss everything together."
    },
    {
      "text": "Slice the spring onions into rings and scatter them over the portions."
    }
  ]

  "steps": [
    {
      "text": "Cook the pasta.",
      "timerMinutes": 10
    },
    {
      "text": "Peel the onion and garlic and chop them finely together with the chicken."
    },
    {
      "text": "Heat the olive oil in a pan. Fry the garlic, onion and chicken.",
      "timerMinutes": 5
    },
    {
      "text": "Add the peas, spinach, cream and goat's cream cheese and let it simmer with the lid on.",
      "timerMinutes": 5
    },
    {
      "text": "Drain the pasta and add it to the pan with the paprika. Season with pepper, salt and nutmeg."
    },
    {
      "text": "Divide between plates and grate the parmesan over the top."
    }

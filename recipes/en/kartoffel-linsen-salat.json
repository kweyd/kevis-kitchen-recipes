  "steps": [
    {
      "text": "Wash the potatoes and cut them into bite-sized pieces."
    },
    {
      "text": "Preheat the oven to 220 °C."
    },
    {
      "text": "Toss the potatoes in a bowl with 2 tbsp olive oil, chopped garlic, paprika and rosemary."
    },
    {
      "text": "Spread them on a baking tray lined with baking paper and roast for 25 minutes.",
      "timerMinutes": 25
    },
    {
      "text": "Put the lentils in a pot with 300 ml water and cook for 20 minutes.",
      "timerMinutes": 20
    },
    {
      "text": "Put the lentils and potatoes in a bowl and sprinkle with chopped dill and parsley."
    },
    {
      "text": "Add the spinach."
    },
    {
      "text": "For the dressing, mix the remaining olive oil with the honey, mustard, balsamic vinegar, pepper and salt and pour over the salad."
    }
  ]

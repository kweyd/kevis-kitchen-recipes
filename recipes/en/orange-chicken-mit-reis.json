  "steps": [
    {
      "text": "Cook the rice.",
      "timerMinutes": 12
    },
    {
      "text": "For the sauce, put the orange zest and juice in a bowl with the soy sauce, water, rice vinegar, sugar, sesame oil and cornflour and stir."
    },
    {
      "text": "Dice the chicken breast, dust it with flour and coat it in milk and breadcrumbs."
    },
    {
      "text": "Air-fry the breaded chicken at 200 °C for 16 minutes, turning after 8 minutes.",
      "timerMinutes": 16
    },
    {
      "text": "Peel and finely chop the garlic and shallot and fry them in a pot with oil.",
      "timerMinutes": 2
    },
    {
      "text": "Add the sauce from the bowl and bring it to the boil until it thickens a little. Season with pepper and salt.",
      "timerMinutes": 3
    },
    {
      "text": "Finally, briefly fold the chicken into the sauce."
    },
    {
      "text": "Spoon the rice onto plates, top with the chicken and sauce and sprinkle with a few pieces of spring onion."
    }
  ]
}

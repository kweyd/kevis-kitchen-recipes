  "steps": [
    {
      "text": "Heat the oil in a pot and brown the mince.",
      "timerMinutes": 5
    },
    {
      "text": "Chop the carrot, onion, garlic and chili, add them to the mince and sweat for 3 minutes.",
      "timerMinutes": 3
    },
    {
      "text": "Add the herbs and tomato paste and stir. Then deglaze with the beef stock."
    },
    {
      "text": "Add the diced tomatoes, salt, pepper and sugar and season to taste."
    },
    {
      "text": "Add the spaghetti and 100 ml water to the pot and simmer with a lid on over medium heat for 11–15 minutes, stirring now and then.",
      "timerMinutes": 12
    },
    {
      "text": "Serve with grated parmesan."
    }
  ]

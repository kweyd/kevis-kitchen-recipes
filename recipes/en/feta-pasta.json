  "steps": [
    {
      "text": "Preheat the oven to 180 °C."
    },
    {
      "text": "Put the feta in a baking dish. Peel and finely chop the garlic and halve the cherry tomatoes."
    },
    {
      "text": "Add both to the feta in the dish, drizzle with olive oil and bake for 20 minutes.",
      "timerMinutes": 20
    },
    {
      "text": "Meanwhile bring a pot of water to the boil and cook the pasta.",
      "timerMinutes": 10
    },
    {
      "text": "Take the dish out of the oven and mash everything with a fork."
    },
    {
      "text": "Season with salt, pepper and Italian herbs."
    },
    {
      "text": "Drain the pasta and toss it with the sauce in the baking dish."
    }
